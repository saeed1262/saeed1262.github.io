</PostLayout>

<script>
  import { onEachPage } from '@/scripts/viz';

  // Copy the paper's BibTeX entry; if the clipboard is blocked, select it instead.
  onEachPage('[data-copy-bib]', (btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.bib ?? '');
        btn.textContent = 'Copied';
      } catch {
        const pre = btn.closest('.bib')?.querySelector('pre');
        if (pre) window.getSelection()?.selectAllChildren(pre);
        btn.textContent = 'Selected: press Ctrl/⌘+C';
      }
      setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
    });
  });
</script>
