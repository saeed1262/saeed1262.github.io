      font: inherit; font-size: 0.8rem; cursor: pointer; color: var(--text); background: var(--surface);
      border: 1px solid var(--border); border-radius: 999px; padding: 0.2rem 0.85rem;
    }
    .bib__copy:hover { border-color: var(--accent-from); }
    @media (max-width: 640px) {
      .aw-ground__row { grid-template-columns: 1fr; }
      .aw-ground__arrow { justify-self: center; transform: rotate(90deg); }
    }
  </style>
  <style is:global>
    /* Code blocks: Shiki dual themes, switched by the site's dark class. */
    .post__body pre.astro-code {
      margin: var(--space-sm) 0 var(--space-md);
      padding: 1rem 1.15rem;
      border-radius: 12px;
      border: 1px solid var(--border);
      background-color: var(--bg-deep) !important;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 0.8rem;
      line-height: 1.6;
      overflow-x: auto;
    }
    .post__body pre.astro-code span { color: var(--shiki-light); background-color: transparent !important; }
    html.dark .post__body pre.astro-code span { color: var(--shiki-dark); }
  </style>
</PostLayout>

<script>
  import { onEachPage } from '@/scripts/viz';

  // Copy the paper's BibTeX entry to the clipboard.
  onEachPage('[data-copy-bib]', (btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.bib ?? '');
        btn.textContent = 'Copied';
      } catch {
        // No clipboard access (old browser, embedded view): select the entry so a keypress copies it.
        const pre = btn.closest('.bib')?.querySelector('pre');
        if (pre) window.getSelection()?.selectAllChildren(pre);
        btn.textContent = 'Selected: press Ctrl/⌘+C';
      }
      setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
    });
  });
</script>
