---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDateFull as formatDate } from '@/utils/format';
import Comments from '@/components/Comments.astro';
// A long-form article page: blog posts, and project pages that need more than Markdown.
interface Props {
  title: string;
  description?: string;
  date?: Date;
  ogImage?: string;
  back?: { href: string; label: string };
  comments?: boolean; // Giscus comments under the article
}
const { title, description, date, ogImage, back = { href: '/blog/', label: 'Blog' }, comments = false } = Astro.props;
---
<BaseLayout title={title} description={description} ogImage={ogImage}>
  <article class="post container">
    <a href={back.href} class="post__back">← {back.label}</a>
    <h1>{title}</h1>
    {description && <p class="post__lead">{description}</p>}
    <slot name="header" />
    {date && <p class="post__date"><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time></p>}
    <div class="post__body prose-page"><slot /></div>
    {comments && <Comments />}
  </article>
  <style>
    .post { padding-block: 9rem var(--space-xl); max-width: 48rem; }
    .post__lead { font-size: var(--step-1); line-height: 1.5; color: var(--text-muted); margin-top: var(--space-sm); }
    .post__back { color: var(--accent-from); font-size: var(--step--1); }
    .post h1 { font-size: var(--step-4); margin-top: var(--space-sm); }
    .post__date { color: var(--text-muted); font-size: var(--step--1); margin-top: var(--space-sm); }
    .post__body { margin-top: var(--space-lg); }
    .post__body :global(p) { margin-bottom: var(--space-sm); }
    .post__body :global(h2) { margin-block: var(--space-lg) var(--space-sm); font-size: var(--step-3); }
    .post__body :global(h3) { margin-block: var(--space-md) var(--space-xs); font-size: var(--step-1); }
    /* Section links stop below the fixed header instead of under it. */
    .post__body :global([id]) { scroll-margin-top: 5.5rem; }
    /* Prose lists only (direct children); lists inside figures style themselves. */
    .post__body > :global(ul), .post__body > :global(ol) { margin-bottom: var(--space-sm); padding-left: 1.3rem; }
    .post__body > :global(ul) > :global(li), .post__body > :global(ol) > :global(li) { margin-bottom: 0.4rem; }
    .post__body :global(blockquote) { margin: var(--space-md) 0; padding: 0.2rem 0 0.2rem 1.2rem; border-left: 3px solid var(--gold); color: var(--text-muted); font-style: italic; }
    .post__body :global(img) { border-radius: 12px; margin-block: var(--space-md); }
    .post__body :global(a) { color: var(--accent-from); text-decoration: underline; }
  </style>
</BaseLayout>
