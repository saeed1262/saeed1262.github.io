---
import '@/styles/tokens.css';
import '@/styles/fonts.css';
import '@/styles/global.css';
// Tailwind v4 (theme + utilities only, no preflight) for the React island hero.
import '@/styles/tailwind.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '@/data/site';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const { title, description = site.description, ogImage = '/images/og-default.png' } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, site.url).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: site.name,
      url: site.url,
      jobTitle: site.position,
      worksFor: { '@type': 'Organization', name: site.company },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'York University' },
      description: site.description,
      sameAs: [
        site.links.github,
        site.links.linkedin,
        site.links.twitter,
        site.links.scholar,
      ],
      knowsAbout: [
        'Machine Learning',
        'Computer Vision',
        'Deep Learning',
        'Agentic AI',
        'Generative Models',
      ],
    },
    {
      '@type': 'WebSite',
      name: site.name,
      url: site.url,
    },
  ],
};
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <script is:inline>
      (function () {
        // Isfahan phases, set by the sun where the visitor is: Dawn (the three
        // hours after sunrise), Workday (on to sunset), Evening (the two hours
        // after sunset), Night (on to sunrise). The theme toggle holds light or
        // dark until the next phase change, as the status bar does in Obsidian.
        var root = document.documentElement;
        var DARK = { evening: true, night: true };

        // Sunrise and sunset in local clock hours. The time zone gives solar noon
        // to within about half an hour and, from its daylight-saving months, the
        // hemisphere; latitude is taken as 40 degrees. No location is asked for.
        function sun(now) {
          var y = now.getFullYear();
          var jan = new Date(y, 0, 1).getTimezoneOffset(), jul = new Date(y, 6, 1).getTimezoneOffset();
          var south = jan < jul;
          var dst = jan !== jul && now.getTimezoneOffset() === Math.min(jan, jul);
          var day = Math.floor((now - new Date(y, 0, 0)) / 864e5);
          var decl = 0.4091 * Math.sin((2 * Math.PI * (284 + day)) / 365);
          var lat = ((south ? -40 : 40) * Math.PI) / 180;
          var half = (Math.acos(Math.max(-1, Math.min(1, -Math.tan(lat) * Math.tan(decl)))) * 12) / Math.PI;
          var noon = 12 + (dst ? 1 : 0);
          return [noon - half, noon + half];
        }
        // The phase now, and the clock hour (from today's midnight) when it ends.
        function phaseAt(now) {
          var s = sun(now), rise = s[0], set = s[1];
          var h = now.getHours() + now.getMinutes() / 60;
          if (h >= rise && h < rise + 3) return ['dawn', rise + 3];
          if (h >= rise + 3 && h < set) return ['workday', set];
          if (h >= set && h < set + 2) return ['evening', set + 2];
          return ['night', h >= set + 2 ? rise + 24 : rise];
        }
        function held() {
          try {
            var v = JSON.parse(localStorage.getItem('isfahan-hold') || 'null');
            return v && v.until > Date.now() ? v : null;
          } catch (e) { return null; }
        }
        function apply() {
          var phase = phaseAt(new Date())[0], h = held();
          if (h && h.dark && !DARK[phase]) phase = 'evening';
          if (h && !h.dark && DARK[phase]) phase = 'workday';
          root.setAttribute('data-phase', phase);
          root.classList.toggle('dark', !!DARK[phase]);
        }
        window.__isfahan = {
          apply: apply,
          // Hold light or dark until the current phase ends.
          hold: function (dark) {
            var now = new Date(), midnight = new Date(now);
            midnight.setHours(0, 0, 0, 0);
            var until = midnight.getTime() + phaseAt(now)[1] * 3600e3;
            try { localStorage.setItem('isfahan-hold', JSON.stringify({ dark: dark, until: until })); } catch (e) {}
            apply();
          },
        };
        try { localStorage.removeItem('theme'); } catch (e) {} // the old toggle's lasting choice
        apply();
        if (!window.__isfahanTimer) window.__isfahanTimer = setInterval(apply, 60000);
        // Re-apply after view-transition swaps (the swapped page's <html> starts as dark).
        if (!window.__themeSwapBound) {
          window.__themeSwapBound = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: Blog`} href="/feed.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, site.url).toString()} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <ClientRouter />
  </head>
  <body>
    <div id="scroll-progress" transition:persist aria-hidden="true"></div>
    <div class="page-band" aria-hidden="true"></div>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script>
      import { initMotion } from '@/scripts/motion';
      import { initChrome } from '@/scripts/chrome';
      import { initZoom } from '@/scripts/zoom';
      function run() {
        initMotion();
        initChrome();
        initZoom();
      }
      // Fires on first load AND after each client-side navigation.
      document.addEventListener('astro:page-load', run);
    </script>
    <style is:global>
      #scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 2px;
        width: 0;
        z-index: 60;
        background: var(--accent-gradient);
        transition: width 0.1s linear;
      }
    </style>
  </body>
</html>
