---
// Figure 10 of the paper: delivered floating against compute as the retry budget grows, for finish-then-filter, for
// aborting at 20% when the decoded guess floats (final check kept), and for a perfect early detector.
---
<figure class="viz pp-early">
  <div class="viz__head">
    <p class="viz__title">Catching floating motions early saves little</p>
    <p class="viz__sub">Floating motions delivered against compute (1 = one full sample), as the number of tries grows</p>
  </div>
  <div class="viz-controls">
    <div class="viz-seg" role="group" aria-label="Model" data-models></div>
    <label class="viz-slider">tries allowed <input type="range" min="0" value="1" data-budget aria-label="Number of tries allowed" /> <strong data-budget-out></strong></label>
  </div>
  <div class="viz-legend">
    <span><i style="background: var(--c-other)"></i>finish, then filter</span>
    <span><i style="background: var(--c-clean)"></i>abort at 20% if the guess floats</span>
    <span><i class="dash" style="color: var(--c-real)"></i>a perfect early detector</span>
  </div>
  <div class="viz__plot" data-plot></div>
  <div class="pp-early__read" data-read></div>
  <figcaption class="viz__caption">
    From Figure 10 of the paper, simulated on the 6,000 recorded MDM samples; every strategy keeps the cheap final
    check. Even a perfect detector saves little, because floating hits only 9 to 18% of samples and clusters in a few
    prompts.
  </figcaption>
</figure>

<style>
  .pp-early__read { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin-top: 0.75rem; }
  .pp-early__read :global(div) { font-size: 0.8rem; color: var(--ink-2); line-height: 1.35; }
  .pp-early__read :global(strong) { display: block; font-size: 1.05rem; color: var(--ink); font-variant-numeric: tabular-nums; }
  @media (max-width: 560px) { .pp-early__read { grid-template-columns: 1fr; } }
</style>

<script>
  import { onEachPage, responsive, svgEl, svgText, linear } from '@/scripts/viz';
  import { early } from '@/data/projects/probing-physics';

  const SERIES = [
    { key: 'filter', label: 'finish, then filter', color: 'var(--c-other)', dash: '' },
    { key: 'rule', label: 'abort at 20% if the guess floats', color: 'var(--c-clean)', dash: '' },
    { key: 'oracle', label: 'perfect early detector', color: 'var(--c-real)', dash: '5 4' },
  ] as const;

  onEachPage('.pp-early', (root) => {
    const plot = root.querySelector<HTMLElement>('[data-plot]')!;
    const seg = root.querySelector<HTMLElement>('[data-models]')!;
    const slider = root.querySelector<HTMLInputElement>('[data-budget]')!;
    const out = root.querySelector<HTMLElement>('[data-budget-out]')!;
    const read = root.querySelector<HTMLElement>('[data-read]')!;
    let m = 0;

    early.forEach((mod, i) => {
      const b = document.createElement('button');
      b.type = 'button'; b.textContent = mod.name; b.setAttribute('aria-pressed', String(i === 0));
      b.addEventListener('click', () => { m = i; seg.querySelectorAll('button').forEach((o, k) => o.setAttribute('aria-pressed', String(k === i))); redraw(); });
      seg.appendChild(b);
    });
    slider.max = String(early[0].filter.length - 1);

    const draw = (width: number) => {
      plot.replaceChildren();
      const mod = early[m];
      const k = Number(slider.value);
      out.textContent = String(mod.filter[k][2]);
      const all = SERIES.flatMap((s) => mod[s.key]);
      const xMax = Math.ceil(Math.max(...all.map((p) => p[0])) * 10) / 10;
      const yMax = Math.ceil(Math.max(...all.map((p) => p[1])) / 2) * 2;
      const H = Math.round(Math.min(300, Math.max(220, width * 0.5)));
      const left = 38, right = 12, top = 10, bottom = H - 30;
      const x = linear(1, xMax, left, width - right);
      const y = linear(0, yMax, bottom, top);
      const svg = svgEl('svg', { viewBox: `0 0 ${width} ${H}`, role: 'img', 'aria-label': `${mod.name}: aborting early moves the curve only slightly toward the perfect detector.` }, plot);
      for (let t = 0; t <= yMax; t += yMax > 10 ? 4 : 2) {
        svgEl('line', { x1: left, x2: width - right, y1: y(t), y2: y(t), class: t === 0 ? 'axis' : 'grid' }, svg);
        svgText(svg, left - 6, y(t) + 4, `${t}%`, { 'text-anchor': 'end' });
      }
      for (let t = 1; t <= xMax + 1e-9; t += 0.1) {
        const tt = Math.round(t * 10) / 10;
        if (Math.round(tt * 10) % 2 === 0 || width > 640) svgText(svg, x(tt), bottom + 18, `${tt.toFixed(1)}×`, { 'text-anchor': 'middle' });
      }
      for (const s of SERIES) {
        const pts = mod[s.key];
        svgEl('polyline', { points: pts.map((p) => `${x(p[0])},${y(p[1])}`).join(' '), fill: 'none', 'stroke-width': 2.2,
          'stroke-dasharray': s.dash || undefined, style: `stroke: ${s.color}` }, svg);
        const p = pts[k];
        svgEl('circle', { cx: x(p[0]), cy: y(p[1]), r: 5, style: `fill: ${s.color}; stroke: var(--viz-surface)`, 'stroke-width': 2 }, svg);
      }
      read.replaceChildren(...SERIES.map((s) => {
        const p = mod[s.key][k];
        const d = document.createElement('div');
        const v = document.createElement('strong');
        v.textContent = `${p[1].toFixed(1)}% floating · ${p[0].toFixed(2)}×`;
        d.append(v, s.label);
        return d;
      }));
    };

    let redraw = () => {};
    responsive(plot, (w) => { redraw = () => draw(w); draw(w); });
    slider.addEventListener('input', () => redraw());
  });
</script>
