---
// A figure with the in-browser motion player (src/scripts/motion-player.ts). The 3D scene, motion data and speech
// load only when the figure nears the viewport; without WebGL the poster and caption show instead.
interface Props {
  src: string; // clip path without extension, e.g. /data/zeggs/feet
  label: string; // what the player shows, for screen readers
  title: string;
  sub?: string;
  show?: string[]; // track ids side by side (default: all)
  switcher?: { label: string; ids: string[]; names: string[] }; // one character, a slider across tracks
  trails?: boolean;
  poster?: string;
}
const { src, label, title, sub, show, switcher, trails = false, poster } = Astro.props;
---
<figure
  class="viz mp"
  data-motion-player
  data-src={src}
  data-show={show?.join(',')}
  data-switcher={switcher ? JSON.stringify(switcher) : undefined}
  data-trails={trails ? '1' : '0'}
>
  <div class="viz__head">
    <p class="viz__title">{title}</p>
    {sub && <p class="viz__sub">{sub}</p>}
  </div>
  <div class="mp__stage" data-stage>
    <canvas data-canvas tabindex="0" role="img" aria-label={`${label} Drag to look around; space plays or pauses.`}></canvas>
    <div class="mp__labels" data-labels aria-hidden="true"></div>
    <audio data-audio preload="none"></audio>
    <div class="mp__fallback" data-fallback hidden>
      {poster && <img src={poster} alt="" loading="lazy" />}
      <p>This figure needs WebGL, which isn't available in this browser.</p>
    </div>
  </div>
  <div class="mp__controls" data-controls>
    <button type="button" class="mp__play" data-play aria-label="Play" data-state="paused"></button>
    <input type="range" class="mp__scrub" data-scrub min="0" max="1000" value="0" aria-label="Position in the clip" />
    <span class="mp__time" data-time aria-hidden="true">0.0 s</span>
    <button type="button" class="mp__sound" data-sound aria-pressed="false">Sound off</button>
  </div>
  {trails && (
    <div class="mp__floor" data-floor hidden>
      <p class="mp__floor-head">Seen from above: each line is one planted ankle, as long as it slid</p>
      <div class="mp__floor-panels" data-floor-panels></div>
    </div>
  )}
  {switcher && (
    <div class="mp__switch">
      <label>
        <span>{switcher.label}</span>
        <input type="range" data-switch min="0" max={switcher.ids.length - 1} step="1" value="0" />
      </label>
      <output data-switch-label>{switcher.names[0]}</output>
    </div>
  )}
  <figcaption class="viz__caption"><slot /></figcaption>
</figure>

<style>
  /* The stage stays light in every palette, like the floor in GenoView. */
  .mp__stage { position: relative; background: #eef0f3; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; aspect-ratio: 16 / 9; }
  .mp__stage canvas { display: block; width: 100%; height: 100%; touch-action: pan-y; cursor: grab; }
  .mp__stage canvas:active { cursor: grabbing; }
  .mp__stage canvas:focus-visible { outline: 2px solid var(--accent-from); outline-offset: -2px; }
  .mp__labels { position: absolute; inset: 0; pointer-events: none; }
  .mp__labels :global(.mp__label) {
    position: absolute; translate: -50% -100%; padding: 0.1rem 0.45rem; border-radius: 999px;
    font-size: 0.78rem; font-weight: 600; color: #172033; background: rgba(255, 255, 255, 0.85); white-space: nowrap;
  }
  .mp__fallback { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; color: #5b6680; padding: 1rem; }
  .mp__fallback[hidden], .mp__controls[hidden] { display: none; }
  .mp__fallback img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.5; }
  .mp__fallback p { position: relative; font-size: var(--step--1); }
  .mp__floor { margin-top: 0.8rem; }
  .mp__floor[hidden] { display: none; }
  .mp__floor-head { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.35rem; }
  .mp__floor-panels { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 0.6rem; }
  .mp__floor-panels :global(.mp__floor-panel) { background: #eef0f3; border: 1px solid var(--border); border-radius: 10px; padding: 0.4rem 0.5rem 0.5rem; }
  .mp__floor-panels :global(.mp__floor-panel p) { font-size: 0.78rem; font-weight: 600; color: #172033; margin-bottom: 0.2rem; }
  .mp__floor-panels :global(svg) { display: block; width: 100%; height: auto; max-height: 15rem; }
  .mp__floor-panels :global(.mp__floor-grid) { stroke: #d5d9df; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .mp__floor-panels :global(.mp__floor-line) { stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; opacity: 0.85; }
  .mp__floor-panels :global(.mp__floor-scale) { stroke: #5b6680; stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .mp__floor-panels :global(.mp__floor-scale-text) { font-size: 0.022px; fill: #5b6680; text-anchor: middle; }
  .mp__controls { display: flex; align-items: center; gap: 0.75rem; margin-top: 0.6rem; }
  .mp__play {
    flex: none; width: 2.2rem; height: 2.2rem; border-radius: 50%; border: 0; cursor: pointer;
    background: var(--accent-from); color: var(--badge-text); display: grid; place-items: center;
  }
  .mp__play::before { content: ""; width: 0; height: 0; margin-left: 3px; border-style: solid; border-width: 0.42rem 0 0.42rem 0.7rem; border-color: transparent transparent transparent currentColor; }
  .mp__play[data-state="playing"]::before { margin-left: 0; width: 0.62rem; height: 0.78rem; border: 0; background: linear-gradient(90deg, currentColor 0 35%, transparent 35% 65%, currentColor 65%); }
  .mp__scrub { flex: 1; min-width: 0; accent-color: var(--accent-from); }
  .mp__time { flex: none; width: 3.4rem; font-variant-numeric: tabular-nums; font-size: var(--step--1); color: var(--text-muted); }
  .mp__sound {
    flex: none; font: inherit; font-size: var(--step--1); padding: 0.3rem 0.75rem; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--border); background: var(--surface); color: var(--text);
  }
  .mp__sound[aria-pressed="true"] { background: var(--accent-from); border-color: var(--accent-from); color: var(--badge-text); }
  .mp__switch { display: flex; align-items: center; gap: 0.9rem; margin-top: 0.6rem; flex-wrap: wrap; }
  .mp__switch label { display: flex; align-items: center; gap: 0.6rem; flex: 1; min-width: 14rem; font-size: var(--step--1); color: var(--text-muted); }
  .mp__switch input { flex: 1; accent-color: var(--accent-from); }
  .mp__switch output { font-size: var(--step--1); font-weight: 600; color: var(--text); min-width: 10rem; }
  @media (max-width: 520px) { .mp__stage { aspect-ratio: 4 / 3; } }
  @media print { .mp__controls, .mp__switch { display: none; } }
</style>

<script>
  import '@/scripts/motion-player';
</script>
