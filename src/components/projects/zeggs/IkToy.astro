---
// Drag the foot target: the hip and knee are re-solved with two-bone IK (src/scripts/ik.ts, as in
// zeggs.postprocess). Past the leg's reach, the hips drop instead of the leg over-stretching.
---
<figure class="viz ik" data-ik>
  <div class="viz__head">
    <p class="viz__title">Two-bone IK, one leg</p>
    <p class="viz__sub">Drag the target (or focus it and use the arrow keys); the hip and knee follow</p>
  </div>
  <div class="ik__plot" data-plot></div>
  <p class="ik__readout" data-readout aria-live="polite"></p>
  <figcaption class="viz__caption">
    A side view with the thigh and shin at 45 and 43 cm. Inside the dashed circle the foot reaches the target with the
    hip where it was. Outside it, <code>--fix_feet</code> lowers the hips just enough, smoothly over time in the real
    motion, rather than stretching the leg straight.
  </figcaption>
</figure>

<style>
  .ik__plot { touch-action: none; }
  .ik__plot :global(svg) { display: block; width: 100%; height: auto; }
  .ik__plot :global(.ik-target) { cursor: grab; }
  .ik__plot :global(.ik-target:focus-visible) { outline: none; }
  .ik__plot :global(.ik-target:focus-visible circle) { stroke-width: 3; }
  .ik__readout { margin-top: 0.4rem; font-size: var(--step--1); color: var(--text-muted); min-height: 1.4em; }
</style>

<script>
  import { onEachPage, svgEl, svgText } from '@/scripts/viz';
  import { solveLeg, type Vec2 } from '@/scripts/ik';

  const UPPER = 0.45;
  const LOWER = 0.43;
  const HIP: Vec2 = [0, 0.9];
  const W = 480;
  const H = 300;
  const S = 260; // px per metre
  const toPx = ([x, y]: Vec2): Vec2 => [W / 2 - 40 + x * S, H - 30 - y * S];
  const toWorld = (px: number, py: number): Vec2 => [(px - (W / 2 - 40)) / S, (H - 30 - py) / S];

  onEachPage('[data-ik]', (fig) => {
    const plot = fig.querySelector<HTMLElement>('[data-plot]')!;
    const readout = fig.querySelector<HTMLElement>('[data-readout]')!;
    let target: Vec2 = [0.12, 0.08];

    const svg = svgEl('svg', { viewBox: `0 0 ${W} ${H}`, role: 'img', 'aria-label': 'A leg drawn from the side. The foot follows a draggable target; the hip lowers when the target is out of reach.' });
    plot.appendChild(svg);
    const [fx0, fy] = toPx([-1, 0]);
    const [fx1] = toPx([1.2, 0]);
    svgEl('line', { x1: fx0, y1: fy, x2: fx1, y2: fy, stroke: 'var(--axis)', 'stroke-width': 1.5 }, svg);
    svgText(svg, fx1 - 4, fy + 18, 'floor', { 'text-anchor': 'end', fill: 'var(--ink-2)', 'font-size': 12 });
    const [hx, hy] = toPx(HIP);
    svgEl('circle', { cx: hx, cy: hy, r: 0.995 * (UPPER + LOWER) * S, fill: 'none', stroke: 'var(--axis)', 'stroke-dasharray': '4 5' }, svg);
    const ghost = svgEl('circle', { cx: hx, cy: hy, r: 6, fill: 'none', stroke: 'var(--ink-2)', 'stroke-dasharray': '2 3' }, svg);
    const dropLine = svgEl('line', { stroke: 'var(--ink-2)', 'stroke-dasharray': '2 3' }, svg);
    const thigh = svgEl('line', { stroke: 'var(--ink)', 'stroke-width': 12, 'stroke-linecap': 'round' }, svg);
    const shin = svgEl('line', { stroke: 'var(--ink)', 'stroke-width': 10, 'stroke-linecap': 'round', opacity: 0.85 }, svg);
    const joints = [0, 1, 2].map(() => svgEl('circle', { r: 5, fill: 'var(--viz-surface)', stroke: 'var(--ink)', 'stroke-width': 2 }, svg));
    const labels = ['hip', 'knee', 'ankle'].map((t) => svgText(svg, 0, 0, t, { fill: 'var(--ink-2)', 'font-size': 12 }));
    const tg = svgEl('g', { class: 'ik-target', tabindex: 0, role: 'slider', 'aria-label': 'Foot target' }, svg);
    svgEl('circle', { r: 11, fill: 'none', stroke: 'var(--accent-from)', 'stroke-width': 2 }, tg);
    svgEl('path', { d: 'M-16 0H-6M6 0H16M0 -16V-6M0 6V16', stroke: 'var(--accent-from)', 'stroke-width': 2 }, tg);

    function draw() {
      const r = solveLeg(HIP, target, UPPER, LOWER);
      const [h, k, a] = [r.hip, r.knee, r.ankle].map(toPx);
      thigh.setAttribute('x1', String(h[0])); thigh.setAttribute('y1', String(h[1]));
      thigh.setAttribute('x2', String(k[0])); thigh.setAttribute('y2', String(k[1]));
      shin.setAttribute('x1', String(k[0])); shin.setAttribute('y1', String(k[1]));
      shin.setAttribute('x2', String(a[0])); shin.setAttribute('y2', String(a[1]));
      [h, k, a].forEach((p, i) => {
        joints[i].setAttribute('cx', String(p[0])); joints[i].setAttribute('cy', String(p[1]));
        // hip to the left, knee to the right, ankle under the foot
        labels[i].setAttribute('x', String(p[0] + [-14, 14, 0][i])); labels[i].setAttribute('y', String(p[1] + [4, 4, 24][i]));
        labels[i].setAttribute('text-anchor', ['end', 'start', 'middle'][i]);
      });
      ghost.style.display = r.drop > 0.001 ? '' : 'none';
      dropLine.setAttribute('x1', String(hx)); dropLine.setAttribute('y1', String(hy));
      dropLine.setAttribute('x2', String(h[0])); dropLine.setAttribute('y2', String(h[1]));
      dropLine.style.display = r.drop > 0.001 ? '' : 'none';
      const [tx, ty] = toPx(target);
      tg.setAttribute('transform', `translate(${tx} ${ty})`);
      tg.setAttribute('aria-valuetext', `${Math.round(target[0] * 100)} cm forward, ${Math.round(target[1] * 100)} cm up`);
      const miss = Math.hypot(r.ankle[0] - target[0], r.ankle[1] - target[1]);
      readout.textContent = r.drop > 0.001
        ? `Out of reach: the hips drop ${(r.drop * 100).toFixed(1)} cm so the foot can stay pinned.`
        : miss > 0.005
          ? 'Too close to the hip: the knee bends as far as it can.'
          : 'In reach: the hip stays put and the knee bends to place the foot.';
    }

    const pt = svg.createSVGPoint();
    function move(e: PointerEvent) {
      pt.x = e.clientX; pt.y = e.clientY;
      const p = pt.matrixTransform(svg.getScreenCTM()!.inverse());
      const [x, y] = toWorld(p.x, p.y);
      target = [Math.max(-0.45, Math.min(0.6, x)), Math.max(0, Math.min(0.5, y))];
      draw();
    }
    let dragging = false;
    svg.addEventListener('pointerdown', (e) => { dragging = true; svg.setPointerCapture(e.pointerId); move(e); });
    svg.addEventListener('pointermove', (e) => { if (dragging) move(e); });
    svg.addEventListener('pointerup', () => { dragging = false; });
    tg.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 0.1 : 0.02;
      const d: Record<string, Vec2> = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, step], ArrowDown: [0, -step] };
      if (!d[e.key]) return;
      e.preventDefault();
      target = [Math.max(-0.45, Math.min(0.6, target[0] + d[e.key][0])), Math.max(0, Math.min(0.5, target[1] + d[e.key][1]))];
      draw();
    });
    draw();
  });
</script>
