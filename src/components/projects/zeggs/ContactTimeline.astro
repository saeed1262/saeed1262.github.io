---
// How --fix_feet finds planted feet: the raw left ankle's height and speed over the 10 s feet clip, with both
// thresholds and the detected contacts shaded. Two charts that share time, never two y-axes on one chart.
import { measured } from '@/data/projects/zeggs';
const t = measured.timeline;
---
<figure class="viz zt" data-timeline={JSON.stringify(t)}>
  <div class="viz__head">
    <p class="viz__title">Finding a planted foot</p>
    <p class="viz__sub">The left ankle in the raw clip above: a foot counts as planted when it is both low and slow</p>
  </div>
  <div class="viz-legend" aria-hidden="true">
    <span><i style="background: var(--c-frank)"></i>Left ankle, raw motion</span>
    <span><i class="dash" style="color: var(--ink-2)"></i>Threshold</span>
    <span><i class="dot zt__swatch"></i>Planted</span>
  </div>
  <div class="viz__plot" data-plot></div>
  <figcaption class="viz__caption">
    Height is above the ankle’s resting height (its 5th percentile over the whole take); speed is in 3D. Planted means
    under {t.heightThresh} cm and under {t.speedThresh} cm/s; gaps shorter than 5 frames are filled and contacts
    shorter than 10 frames dropped. This is the first pass, on the raw motion: after the whole-body drift is removed,
    the second pass finds more contacts.
  </figcaption>
</figure>

<style>
  .zt__swatch { background: color-mix(in srgb, var(--c-clean) 22%, transparent); outline: 1px solid color-mix(in srgb, var(--c-clean) 45%, transparent); }
</style>

<script>
  import { onEachPage, responsive, svgEl, svgText, linear } from '@/scripts/viz';

  interface Timeline { fps: number; height: number[]; speed: number[]; heightThresh: number; speedThresh: number; contacts: [number, number][] }

  onEachPage('.zt', (root) => {
    const plot = root.querySelector<HTMLElement>('[data-plot]')!;
    const t = JSON.parse(root.dataset.timeline!) as Timeline;
    const n = t.height.length;
    const tip = document.createElement('div');
    tip.className = 'viz-tip';
    tip.hidden = true;
    responsive(plot, (width) => {
      plot.replaceChildren(tip);
      const left = 44, right = width - 8, chartH = 110, gap = 30, axisH = 22;
      const H = chartH * 2 + gap + axisH + 8;
      const x = linear(0, (n - 1) / t.fps, left, right);
      const svg = svgEl('svg', { viewBox: `0 0 ${width} ${H}`, role: 'img', 'aria-label': 'Two line charts sharing time: the left ankle’s height and speed, with thresholds and shaded contacts.' }, plot);
      const panels = [
        { key: 'height' as const, label: 'Height (cm)', thresh: t.heightThresh, top: 8 },
        { key: 'speed' as const, label: 'Speed (cm/s)', thresh: t.speedThresh, top: 8 + chartH + gap },
      ];
      const ys = panels.map((p) => {
        const vals = t[p.key];
        const max = Math.max(p.thresh * 2, Math.ceil(Math.max(...vals) / 10) * 10);
        const capped = Math.min(max, p.key === 'height' ? 30 : 200);
        const y = linear(0, capped, p.top + chartH, p.top);
        for (const [s, e] of t.contacts) {
          svgEl('rect', { x: x(s / t.fps), y: p.top, width: Math.max(1, x(e / t.fps) - x(s / t.fps)), height: chartH, style: 'fill: color-mix(in srgb, var(--c-clean) 18%, transparent)' }, svg);
        }
        for (const v of [0, capped / 2, capped]) {
          svgEl('line', { x1: left, x2: right, y1: y(v), y2: y(v), class: v === 0 ? 'axis' : 'grid' }, svg);
          svgText(svg, left - 6, y(v) + 4, String(Math.round(v)), { 'text-anchor': 'end' });
        }
        svgText(svg, right, p.top + 11, p.label, { 'text-anchor': 'end', class: 't-ink' });
        svgEl('line', { x1: left, x2: right, y1: y(p.thresh), y2: y(p.thresh), style: 'stroke: var(--ink-2)', 'stroke-dasharray': '4 4', 'stroke-width': 1.2 }, svg);
        const d = vals.map((v, i) => `${i ? 'L' : 'M'}${x(i / t.fps).toFixed(1)},${y(Math.min(v, capped)).toFixed(1)}`).join('');
        svgEl('path', { d, fill: 'none', style: 'stroke: var(--c-frank)', 'stroke-width': 2, 'stroke-linejoin': 'round' }, svg);
        return y;
      });
      const base = 8 + chartH * 2 + gap;
      for (let s = 0; s <= 10; s += 2) svgText(svg, x(s), base + 16, `${s} s`, { 'text-anchor': 'middle' });
      // Crosshair and readout.
      const cross = svgEl('line', { y1: 8, y2: base, style: 'stroke: var(--axis)', 'stroke-width': 1 }, svg);
      const dots = ys.map(() => svgEl('circle', { r: 4, style: 'fill: var(--c-frank); stroke: var(--viz-surface)', 'stroke-width': 2 }, svg));
      cross.style.display = 'none';
      dots.forEach((c) => (c.style.display = 'none'));
      svg.addEventListener('pointermove', (e) => {
        const box = svg.getBoundingClientRect();
        const sc = box.width / width;
        const px = (e.clientX - box.left) / sc;
        const i = Math.max(0, Math.min(n - 1, Math.round(x.invert(px) * t.fps)));
        const cx = x(i / t.fps);
        cross.setAttribute('x1', String(cx)); cross.setAttribute('x2', String(cx));
        cross.style.display = '';
        panels.forEach((p, k) => {
          dots[k].setAttribute('cx', String(cx));
          dots[k].setAttribute('cy', String(ys[k](Math.min(t[p.key][i], p.key === 'height' ? 30 : 200))));
          dots[k].style.display = '';
        });
        const planted = t.contacts.some(([s, e]) => i >= s && i < e);
        tip.replaceChildren();
        const title = document.createElement('div');
        title.className = 'viz-tip__title';
        title.textContent = `${(i / t.fps).toFixed(2)} s · ${planted ? 'planted' : 'not planted'}`;
        tip.appendChild(title);
        for (const [v, l] of [[`${t.height[i].toFixed(1)} cm`, 'height'], [`${t.speed[i].toFixed(0)} cm/s`, 'speed']]) {
          const row = document.createElement('div');
          row.className = 'viz-tip__row';
          const b = document.createElement('strong'); b.textContent = v;
          const s = document.createElement('span'); s.textContent = l;
          row.append(b, s);
          tip.appendChild(row);
        }
        tip.hidden = false;
        const tw = tip.offsetWidth;
        tip.style.left = `${cx * sc + 14 + tw > box.width - 8 ? cx * sc - tw - 14 : cx * sc + 14}px`;
        tip.style.top = '4px';
      });
      svg.addEventListener('pointerleave', () => {
        tip.hidden = true;
        cross.style.display = 'none';
        dots.forEach((c) => (c.style.display = 'none'));
      });
    });
  });
</script>
