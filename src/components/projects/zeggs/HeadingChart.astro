---
// Heading over time for the worst feet run: raw, and with --fix_heading (and --fix_feet), with the ±20° limit.
import { measured } from '@/data/projects/zeggs';
const h = measured.heading;
const maxRaw = Math.max(...h.raw.map(Math.abs));
const maxFixed = Math.max(...h.fixed.map(Math.abs));
---
<figure class="viz zh" data-heading={JSON.stringify(h)}>
  <div class="viz__head">
    <p class="viz__title">Turning away from the camera</p>
    <p class="viz__sub">Which way the hips face, in degrees from where they started</p>
  </div>
  <div class="viz-legend" aria-hidden="true">
    <span><i style="background: var(--c-frank)"></i>Raw</span>
    <span><i style="background: var(--c-clean)"></i>With --fix_heading</span>
    <span><i class="dot zh__band"></i>±{h.limit}° limit on the slow trend</span>
  </div>
  <div class="viz__plot" data-plot></div>
  <figcaption class="viz__caption">
    The same run as the feet clip, over its whole length. The two lines are the same until the slow trend passes the
    limit; from there the fix turns it back. Raw, the character turns up to {Math.round(maxRaw)}° away;
    with <code>--fix_heading</code> at most {Math.round(maxFixed)}°. Turns faster than about four seconds are kept,
    so the character can still turn while it speaks; only the slow trend beyond the limit is turned back, around the
    point between the feet.
  </figcaption>
  <details>
    <summary>Show as a table</summary>
    <div class="table-wrap">
      <table>
        <thead><tr><th></th><th>Largest turn</th><th>At the end</th></tr></thead>
        <tbody>
          <tr><td>Raw</td><td>{Math.round(maxRaw)}°</td><td>{Math.round(h.raw[h.raw.length - 1])}°</td></tr>
          <tr><td>With --fix_heading</td><td>{Math.round(maxFixed)}°</td><td>{Math.round(h.fixed[h.fixed.length - 1])}°</td></tr>
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .zh__band { background: color-mix(in srgb, var(--c-clean) 16%, transparent); border-radius: 2px !important; }
</style>

<script>
  import { onEachPage, responsive, svgEl, svgText, linear } from '@/scripts/viz';

  interface Heading { fps: number; raw: number[]; fixed: number[]; limit: number }
  const SERIES = [
    { key: 'raw' as const, name: 'Raw', color: 'var(--c-frank)' },
    { key: 'fixed' as const, name: 'With --fix_heading', color: 'var(--c-clean)' },
  ];

  onEachPage('.zh', (root) => {
    const plot = root.querySelector<HTMLElement>('[data-plot]')!;
    const h = JSON.parse(root.dataset.heading!) as Heading;
    const n = h.raw.length;
    const dur = (n - 1) / h.fps;
    const tip = document.createElement('div');
    tip.className = 'viz-tip';
    tip.hidden = true;
    responsive(plot, (width) => {
      plot.replaceChildren(tip);
      const left = 42, right = width - (width < 520 ? 8 : 96), top = 8, bottom = 230, H = bottom + 24;
      const all = [...h.raw, ...h.fixed];
      const lim = Math.ceil(Math.max(...all.map(Math.abs), h.limit) / 45) * 45;
      const x = linear(0, dur, left, right);
      const y = linear(-lim, lim, bottom, top);
      const svg = svgEl('svg', { viewBox: `0 0 ${width} ${H}`, role: 'img', 'aria-label': `Line chart of heading over ${Math.round(dur)} seconds, raw and with --fix_heading.` }, plot);
      svgEl('rect', { x: left, y: y(h.limit), width: right - left, height: y(-h.limit) - y(h.limit), style: 'fill: color-mix(in srgb, var(--c-clean) 12%, transparent)' }, svg);
      for (let v = -lim; v <= lim; v += 45) {
        svgEl('line', { x1: left, x2: right, y1: y(v), y2: y(v), class: v === 0 ? 'axis' : 'grid' }, svg);
        svgText(svg, left - 6, y(v) + 4, `${v}°`, { 'text-anchor': 'end' });
      }
      const tStep = dur > 90 ? 30 : 15;
      for (let s = 0; s <= dur; s += tStep) svgText(svg, x(s), bottom + 16, `${s} s`, { 'text-anchor': 'middle' });
      for (const s of SERIES) {
        const d = h[s.key].map((v, i) => `${i ? 'L' : 'M'}${x(i / h.fps).toFixed(1)},${y(v).toFixed(1)}`).join('');
        svgEl('path', { d, fill: 'none', style: `stroke: ${s.color}`, 'stroke-width': 2, 'stroke-linejoin': 'round' }, svg);
        if (width >= 520) {
          const last = h[s.key][n - 1];
          svgText(svg, right + 6, y(last) + 4, s.key === 'raw' ? 'Raw' : 'Fixed', { class: 't-ink' });
        }
      }
      const cross = svgEl('line', { y1: top, y2: bottom, style: 'stroke: var(--axis)' }, svg);
      const dots = SERIES.map((s) => svgEl('circle', { r: 4, style: `fill: ${s.color}; stroke: var(--viz-surface)`, 'stroke-width': 2 }, svg));
      const hide = () => { tip.hidden = true; cross.style.display = 'none'; dots.forEach((d) => (d.style.display = 'none')); };
      hide();
      svg.addEventListener('pointermove', (e) => {
        const box = svg.getBoundingClientRect();
        const sc = box.width / width;
        const i = Math.max(0, Math.min(n - 1, Math.round(x.invert((e.clientX - box.left) / sc) * h.fps)));
        const cx = x(i / h.fps);
        cross.setAttribute('x1', String(cx)); cross.setAttribute('x2', String(cx)); cross.style.display = '';
        SERIES.forEach((s, k) => { dots[k].setAttribute('cx', String(cx)); dots[k].setAttribute('cy', String(y(h[s.key][i]))); dots[k].style.display = ''; });
        tip.replaceChildren();
        const title = document.createElement('div');
        title.className = 'viz-tip__title';
        title.textContent = `${(i / h.fps).toFixed(1)} s`;
        tip.appendChild(title);
        for (const s of SERIES) {
          const row = document.createElement('div');
          row.className = 'viz-tip__row';
          const key = document.createElement('span'); key.className = 'viz-tip__key'; key.style.background = s.color;
          const b = document.createElement('strong'); b.textContent = `${h[s.key][i].toFixed(0)}°`;
          const l = document.createElement('span'); l.textContent = s.name;
          row.append(key, b, l);
          tip.appendChild(row);
        }
        tip.hidden = false;
        const tw = tip.offsetWidth;
        tip.style.left = `${cx * sc + 14 + tw > box.width - 8 ? cx * sc - tw - 14 : cx * sc + 14}px`;
        tip.style.top = '4px';
      });
      svg.addEventListener('pointerleave', hide);
    });
  });
</script>
