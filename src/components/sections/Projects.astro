---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Reveal from '@/components/ui/Reveal.astro';
import Card from '@/components/ui/Card.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';

const projects = await getCollection('projects');
const projectImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/*', { eager: true });

function imageFor(file?: string) {
  if (!file) return undefined;
  return projectImages[`/src/assets/projects/${file}`]?.default;
}
---
<section id="projects" class="projects container">
  <SectionHeading kicker="Work" title="Projects" />
  <div class="projects__grid">
    {projects.map((proj) => {
      const img = imageFor(proj.data.image);
      return (
        <Reveal>
          <Card class="project">
            <div class="project__media">
              {img && <Image src={img} alt={proj.data.title} width={640} loading="lazy" class="project__img" />}
            </div>
            <h3>{proj.data.title}</h3>
            <p class="project__desc">{proj.data.description}</p>
            {proj.data.tags.length > 0 && (
              <ul class="project__tags">{proj.data.tags.map((t) => <li>{t}</li>)}</ul>
            )}
            <a class="project__link" href={`/projects/${proj.id}/`}>Read more →</a>
          </Card>
        </Reveal>
      );
    })}
  </div>
  <style>
    .projects { padding-block: var(--space-xl); }
    .projects__grid { display: grid; gap: var(--space-md); grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
    .projects__grid > :global(*) { display: flex; }
    .project { display: flex; flex-direction: column; width: 100%; }
    /* Every image sits in the same 16:10 frame; nothing is cropped. */
    .project__media { position: relative; aspect-ratio: 16 / 10; border-radius: 12px; margin-bottom: var(--space-sm); background: var(--bg-deep); overflow: hidden; }
    .project__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
    .project__desc { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
    .project__link { margin-top: auto; padding-top: 0.5rem; font-weight: 500; }
    .project h3 { font-size: var(--step-1); margin-top: 0.25rem; }
    .project p { color: var(--text-muted); margin-block: 0.5rem; }
    .project__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0.5rem 0; }
    .project__tags li { font-size: var(--step--1); color: var(--accent-from); background: color-mix(in srgb, var(--accent-from) 12%, transparent); border: 1px solid transparent; border-radius: 999px; padding: 0.15rem 0.6rem; }
    .project a { color: var(--accent-from); }
  </style>
</section>
