---
import { getCollection } from 'astro:content';
import { formatDateFull } from '@/utils/format';
import { inlineMarkdownToHtml } from '@/utils/markdown';
import SectionHeading from '@/components/ui/SectionHeading.astro';

const items = (await getCollection('news')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const latest = items.slice(0, 5);
const older = items.slice(5);
---
<section id="news" class="timeline container">
  <SectionHeading kicker="Timeline" title="News & milestones" />
  <ul class="news-list">
    {latest.map((item) => (
      <li class="news-item">
        <span class="news-item__date">{formatDateFull(item.data.date)}</span>
        <span class="news-item__text" set:html={inlineMarkdownToHtml(item.data.text)} />
      </li>
    ))}
  </ul>
  {older.length > 0 && (
    <details class="news-more">
      <summary>Show all {items.length} updates</summary>
      <ul class="news-list">
        {older.map((item) => (
          <li class="news-item">
            <span class="news-item__date">{formatDateFull(item.data.date)}</span>
            <span class="news-item__text" set:html={inlineMarkdownToHtml(item.data.text)} />
          </li>
        ))}
      </ul>
    </details>
  )}
  <style>
    .timeline { padding-block: var(--space-xl); }
    .news-more { margin-top: 0.85rem; }
    .news-more summary { cursor: pointer; color: var(--accent-from); font-weight: 500; list-style: none; display: inline-flex; align-items: center; gap: 0.4rem; }
    .news-more summary::-webkit-details-marker { display: none; }
    .news-more summary::after { content: "↓"; transition: rotate 0.2s; }
    .news-more[open] summary::after { rotate: 180deg; }
    .news-more[open] summary { margin-bottom: 0.85rem; }

    .news-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.85rem; }
    /* each news = its own floating panel */
    .news-item {
      display: flex;
      align-items: center;
      background: var(--surface);
      border: 1px solid var(--border);
      border-left: 3px solid var(--gold);
      border-radius: 12px;
      box-shadow: var(--shadow-card);
      transition: box-shadow 0.25s var(--ease-out), transform 0.25s var(--ease-out), border-color 0.25s var(--ease-out);
    }
    .news-item:hover {
      border-color: color-mix(in srgb, var(--accent-from) 55%, var(--border));
      box-shadow: var(--shadow-hover);
      transform: translateY(-2px);
    }
    .news-item__date {
      flex: 0 0 9rem;
      padding: 1.1rem 1.25rem;
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--text-muted);
      white-space: nowrap;
    }
    .news-item__text {
      padding: 1.1rem 1.5rem 1.1rem 0.5rem;
      font-size: var(--step-0);
      line-height: 1.55;
      color: var(--text);
    }
    .news-item__text :global(a) { color: var(--accent-from); text-decoration: none; }
    .news-item__text :global(a:hover) { text-decoration: underline; }
    @media (max-width: 560px) {
      .news-item { flex-direction: column; align-items: flex-start; }
      .news-item__date { flex-basis: auto; padding-bottom: 0.1rem; }
      .news-item__text { padding: 0.1rem 1.25rem 1.1rem; }
    }
  </style>
</section>
