---
import { Image } from 'astro:assets';
import Reveal from '@/components/ui/Reveal.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { posts, postImage } from '@/data/posts';
import { formatDateFull } from '@/utils/format';

// The newest few posts; the full list lives at /blog/.
const latest = posts.slice(0, 3);
---
<section id="blog" class="home-blog container">
  <SectionHeading kicker="Writing" title="Blog" />
  <div class="home-blog__list">
    {latest.map((p) => {
      const img = postImage(p);
      return (
        <Reveal>
          <article class="bp">
            {img && (
              <a class="bp__media" href={`/blog/${p.slug}/`} tabindex="-1" aria-hidden="true">
                <Image src={img} alt="" width={800} loading="lazy" class="bp__img" />
              </a>
            )}
            <div class="bp__body">
              <p class="bp__meta"><time datetime={p.date}>{formatDateFull(p.date)}</time></p>
              <h3 class="bp__title"><a href={`/blog/${p.slug}/`}>{p.title}</a></h3>
              <p class="bp__desc">{p.description}</p>
              <ul class="bp__tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
              <div class="bp__links">
                <a href={`/blog/${p.slug}/`}>Read the post →</a>
              </div>
            </div>
          </article>
        </Reveal>
      );
    })}
  </div>
  <p class="home-blog__all"><a href="/blog/">All posts →</a></p>
  <style>
    .home-blog { padding-block: var(--space-xl); }
    .home-blog__list { display: grid; gap: var(--space-md); }
    .bp {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: var(--shadow-card);
      overflow: hidden;
      transition: border-color 0.3s;
    }
    .bp:hover { border-color: color-mix(in srgb, var(--accent-from) 45%, var(--border)); }
    .bp__media { position: relative; display: block; min-height: 16rem; background: #0d1329; border-right: 1px solid var(--border); }
    .bp__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .bp__body { padding: var(--space-md); display: flex; flex-direction: column; }
    .bp__meta { color: var(--gold-text); font-variant: small-caps; letter-spacing: 0.08em; font-size: var(--step--1); }
    .bp__title { font-family: var(--font-display); font-size: var(--step-2); font-weight: 600; line-height: 1.12; margin-top: 0.3rem; }
    .bp__title a:hover { color: var(--accent-from); }
    .bp__desc { color: var(--text-muted); margin-top: var(--space-sm); }
    .bp__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin-top: var(--space-sm); }
    .bp__tags li { font-size: var(--step--1); color: var(--accent-from); background: color-mix(in srgb, var(--accent-from) 12%, transparent); border-radius: 999px; padding: 0.15rem 0.6rem; }
    .bp__links { margin-top: auto; padding-top: var(--space-sm); }
    .bp__links a, .home-blog__all a { color: var(--accent-from); font-weight: 500; }
    .bp__links a:hover, .home-blog__all a:hover { text-decoration: underline; }
    .home-blog__all { margin-top: var(--space-md); text-align: right; }
    @media (max-width: 768px) {
      .bp { grid-template-columns: 1fr; }
      .bp__media { min-height: 0; aspect-ratio: 16 / 10; border-right: 0; border-bottom: 1px solid var(--border); }
    }
  </style>
</section>
