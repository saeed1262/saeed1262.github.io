---
import Reveal from '@/components/ui/Reveal.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { talks } from '@/data/talks';

const given = talks.filter((t) => t.kind === 'talk');
const featured = talks.filter((t) => t.kind === 'feature');
---
<section id="talks" class="talks container">
  <SectionHeading kicker="Speaking" title="Talks & features" />
  <div class="talks__grid">
    <Reveal>
      <div class="talks__card">
        <h3 class="talks__head">Talks</h3>
        <ul class="talks__list">
          {given.map((t) => (
            <li class="talk">
              <span class="talk__year">{t.year}</span>
              <div class="talk__main">
                <p class="talk__title">{t.title}</p>
                <p class="talk__venue">{t.venue}</p>
                {t.links && (
                  <p class="talk__links">{t.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </Reveal>
    <Reveal>
      <div class="talks__card">
        <h3 class="talks__head">Featured in</h3>
        <ul class="talks__list">
          {featured.map((t) => (
            <li class="talk talk--feature">
              <div class="talk__main">
                <p class="talk__title">{t.title}</p>
                <p class="talk__venue">{t.venue}</p>
                {t.links && (
                  <p class="talk__links">{t.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </Reveal>
  </div>
  <style>
    .talks { padding-block: var(--space-xl); }
    .talks__grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--space-md); align-items: start; }
    .talks__grid > :global(*) { display: flex; }
    .talks__card { width: 100%; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow-card); padding: var(--space-md); }
    .talks__head { font-size: var(--step-0); font-variant: small-caps; letter-spacing: 0.12em; text-transform: lowercase; color: var(--gold-text); margin-bottom: var(--space-sm); }
    .talks__list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-sm); }
    .talk { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr); gap: 0.75rem; padding-bottom: var(--space-sm); border-bottom: 1px solid var(--border); }
    .talk:last-child { border-bottom: 0; padding-bottom: 0; }
    .talk--feature { grid-template-columns: minmax(0, 1fr); }
    .talk__year { font-size: var(--step--1); color: var(--accent-from); font-weight: 600; font-variant-numeric: tabular-nums; padding-top: 0.1rem; }
    .talk__title { font-weight: 600; line-height: 1.35; }
    .talk__venue { color: var(--text-muted); font-size: var(--step--1); margin-top: 0.15rem; }
    .talk__links { display: flex; gap: 0.9rem; margin-top: 0.3rem; font-size: var(--step--1); }
    .talk__links a { color: var(--accent-from); }
    .talk__links a:hover { text-decoration: underline; }
    @media (max-width: 768px) { .talks__grid { grid-template-columns: 1fr; } }
  </style>
</section>
