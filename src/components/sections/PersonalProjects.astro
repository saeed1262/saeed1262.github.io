---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Reveal from '@/components/ui/Reveal.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';

const projects = await getCollection('personal');
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/personal/*', { eager: true });
const imageFor = (file?: string) => (file ? images[`/src/assets/personal/${file}`]?.default : undefined);
---
<section id="personal" class="personal container">
  <SectionHeading kicker="Personal" title="Personal projects" />
  <div class="personal__list">
    {projects.map(({ data }) => {
      const img = imageFor(data.image);
      return (
        <Reveal>
          <article class="pp">
            {img && (
              <div class="pp__media">
                <Image src={img} alt={data.imageAlt ?? data.title} width={720} loading="lazy" class="pp__img" />
              </div>
            )}
            <div class="pp__body">
              {data.kind && <p class="pp__kind">{data.kind}</p>}
              <h3 class="pp__title">{data.title}</h3>
              <p class="pp__desc">{data.description}</p>
              {data.tags.length > 0 && (
                <ul class="pp__tags">{data.tags.map((t) => <li>{t}</li>)}</ul>
              )}
              {data.links.length > 0 && (
                <div class="pp__links">
                  {data.links.map((l) => (
                    <a href={l.url} target="_blank" rel="noopener">{l.label} →</a>
                  ))}
                </div>
              )}
            </div>
          </article>
        </Reveal>
      );
    })}
  </div>
  <style>
    .personal { padding-block: var(--space-xl); }
    .personal__list { display: grid; gap: var(--space-md); }
    .pp {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: var(--shadow-card);
      overflow: hidden;
      transition: border-color 0.3s;
    }
    .pp:hover { border-color: color-mix(in srgb, var(--accent-from) 45%, var(--border)); }
    .pp__media { position: relative; min-height: 16rem; background: var(--bg-deep); border-right: 1px solid var(--border); }
    .pp__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center top; }
    .pp__body { padding: var(--space-md); display: flex; flex-direction: column; }
    .pp__kind { color: var(--gold-text); font-variant: small-caps; letter-spacing: 0.14em; font-size: var(--step--1); }
    .pp__title { font-family: var(--font-display); font-size: var(--step-3); font-weight: 600; line-height: 1.05; margin-top: 0.3rem; }
    .pp__desc { color: var(--text-muted); margin-top: var(--space-sm); }
    .pp__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin-top: var(--space-sm); }
    .pp__tags li { font-size: var(--step--1); color: var(--accent-from); background: color-mix(in srgb, var(--accent-from) 12%, transparent); border-radius: 999px; padding: 0.15rem 0.6rem; }
    .pp__links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-top: auto; padding-top: var(--space-sm); }
    .pp__links a { color: var(--accent-from); font-weight: 500; }
    .pp__links a:hover { text-decoration: underline; }
    @media (max-width: 768px) {
      .pp { grid-template-columns: 1fr; }
      .pp__media { min-height: 0; aspect-ratio: 16 / 10; border-right: 0; border-bottom: 1px solid var(--border); }
    }
  </style>
</section>
