---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '@/components/ui/SectionHeading.astro';

const pubs = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);

function slugify(s: string): string {
  return s
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

// Sorted union of all topics actually used.
const topics = [...new Set(pubs.flatMap((p) => p.data.topics))].sort();

// Group consecutive same-year pubs (already sorted by year desc).
type Group = { year: number; items: typeof pubs };
const groups: Group[] = [];
for (const p of pubs) {
  const last = groups[groups.length - 1];
  if (last && last.year === p.data.year) {
    last.items.push(p);
  } else {
    groups.push({ year: p.data.year, items: [p] });
  }
}

function highlightAuthors(authors: string): string {
  return authors.replaceAll('Saeed Ghorbani', '<strong class="pub__me">Saeed Ghorbani</strong>');
}

function toBibtex(p: CollectionEntry<'publications'>): string {
  const d = p.data;
  return `@article{${p.id},
  title   = {${d.title}},
  author  = {${d.authors}},
  journal = {${d.venue}},
  year    = {${d.year}}
}`;
}
---
<section id="publications" class="pubs container">
  <SectionHeading kicker="Research" title="Selected publications" />

  <div class="pubs__filters">
    <button type="button" class="pubs__pill is-active" data-filter="all">All</button>
    {topics.map((t) => (
      <button type="button" class="pubs__pill" data-filter={slugify(t)}>{t}</button>
    ))}
  </div>

  <div class="pubs__list">
    {groups.map((g) => (
      <div class="pubs__group" data-year={g.year}>
        <h3 class="pubs__year">{g.year}</h3>
        {g.items.map((p) => (
          <article class="pub" data-topics={p.data.topics.map(slugify).join(' ')}>
            <div class="pub__badge"><span class="pub__abbr">{p.data.abbr ?? p.data.venue}</span></div>
            <div class="pub__main">
              <h3 class="pub__title">{p.data.title}</h3>
              {p.data.award && <span class="pub__award">{p.data.award}</span>}
              <p class="pub__authors" set:html={highlightAuthors(p.data.authors)} />
              <div class="pub__meta">
              <p class="pub__venue"><em>{p.data.venue} {p.data.year}</em></p>
              <div class="pub__actions">
                {p.data.abstract && <button type="button" class="pub__btn" data-toggle="abs">ABS</button>}
                <button type="button" class="pub__btn" data-toggle="bib">BIB</button>
                {p.data.links?.pdf && <a class="pub__btn" href={p.data.links.pdf} target="_blank" rel="noopener">PDF</a>}
                {p.data.links?.code && <a class="pub__btn" href={p.data.links.code} target="_blank" rel="noopener">CODE</a>}
                {p.data.links?.project && <a class="pub__btn" href={p.data.links.project} target="_blank" rel="noopener">WEBSITE</a>}
              </div>
              </div>
              {p.data.abstract && <div class="pub__panel pub__abstract" hidden><p>{p.data.abstract}</p></div>}
              <div class="pub__panel pub__bibtex" hidden><pre>{toBibtex(p)}</pre></div>
            </div>
          </article>
        ))}
      </div>
    ))}
  </div>

  <style>
    .pubs { padding-block: var(--space-xl); }
    .pubs__list { display: grid; gap: var(--space-sm); }

    .pubs__filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: var(--space-md); }
    .pubs__pill {
      font: inherit;
      font-size: var(--step--1);
      color: var(--text-muted);
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.4rem 0.9rem;
      cursor: pointer;
      transition: all .2s var(--ease-out);
    }
    .pubs__pill:hover { color: var(--text); border-color: color-mix(in srgb, var(--accent-from) 45%, var(--border)); }
    .pubs__pill.is-active { color: var(--badge-text); background: var(--accent-gradient); border-color: transparent; }

    .pubs__group { display: grid; gap: 0.6rem; margin-bottom: var(--space-md); }
    .pubs__year {
      font-family: var(--font-display);
      font-size: var(--step-1);
      color: var(--gold-text);
      padding-bottom: 0.25rem;
      border-bottom: 1px solid var(--border);
    }

    .pub.is-hidden, .pubs__group.is-hidden { display: none; }

    .pub {
      display: grid;
      grid-template-columns: 4.75rem 1fr;
      gap: 1rem;
      align-items: start;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 0.9rem 1.15rem;
      transition: border-color 0.2s;
    }
    .pub:hover { border-color: color-mix(in srgb, var(--accent-from) 40%, var(--border)); }

    .pub__abbr {
      display: inline-block;
      background: var(--accent-gradient);
      color: var(--badge-text);
      font-weight: 600;
      font-size: 0.68rem;
      letter-spacing: 0.04em;
      padding: 0.2rem 0.6rem;
      border-radius: 999px;
      margin-top: 0.15rem;
    }

    .pub__title { font-size: 1.05rem; font-weight: 600; line-height: 1.35; }
    .pub__award { color: var(--accent-from); font-size: var(--step--1); }

    .pub__authors { margin-top: 0.2rem; color: var(--text-muted); font-size: 0.88rem; line-height: 1.45; }
    .pub__authors :global(.pub__me) {
      color: var(--text);
      font-weight: 600;
      text-decoration: underline;
      text-decoration-color: var(--accent-from);
    }

    .pub__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.35rem 0.9rem;
      margin-top: 0.35rem;
    }
    .pub__venue { color: var(--text-muted); font-size: 0.82rem; }

    .pub__actions { display: flex; flex-wrap: wrap; gap: 0.35rem; }

    .pub__btn {
      font: inherit;
      font-size: 0.66rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-muted);
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.15rem 0.5rem;
      cursor: pointer;
      text-decoration: none;
      transition: border-color .2s, color .2s, background .2s;
    }
    .pub__btn:hover, .pub__btn.is-open {
      border-color: color-mix(in srgb, var(--accent-from) 55%, var(--border));
      color: var(--accent-from);
    }

    .pub__panel { margin-top: var(--space-sm); color: var(--text-muted); font-size: var(--step--1); line-height: 1.6; }
    .pub__bibtex pre {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: var(--space-sm);
      overflow: auto;
      white-space: pre;
      font-size: 0.78rem;
    }

    [hidden] { display: none; }

    @media (max-width: 640px) {
      .pub { grid-template-columns: 1fr; gap: 0.4rem; padding: 0.85rem 1rem; }
      .pub__badge { text-align: left; }
    }
  </style>

  <script>
    declare global {
      interface Window {
        __pubsDelegated?: boolean;
      }
    }

    // Document-level event delegation, attached ONCE. Because the listener
    // lives on `document` and matches via .closest(), it keeps working after
    // view-transition DOM swaps with no re-binding. The guard prevents a second
    // attachment if this module ever re-evaluates.
    if (!window.__pubsDelegated) {
      window.__pubsDelegated = true;

      document.addEventListener('click', (event) => {
        const target = event.target as Element | null;
        if (!target) return;

        // ABS / BIB panel toggles.
        const toggleBtn = target.closest<HTMLElement>('.pub__btn[data-toggle]');
        if (toggleBtn) {
          const sel = toggleBtn.getAttribute('data-toggle') === 'abs' ? '.pub__abstract' : '.pub__bibtex';
          const panel = toggleBtn.closest('.pub')?.querySelector<HTMLElement>(sel);
          if (panel) {
            panel.hidden = !panel.hidden;
            toggleBtn.classList.toggle('is-open', !panel.hidden);
          }
          return;
        }

        // Topic filter pills.
        const pill = target.closest<HTMLButtonElement>('.pubs__pill');
        if (pill) {
          const filters = pill.closest('.pubs__filters');
          if (filters) {
            filters.querySelectorAll('.pubs__pill').forEach((p) => p.classList.remove('is-active'));
          }
          pill.classList.add('is-active');

          const filter = pill.getAttribute('data-filter') || 'all';
          const scope = filters?.parentElement ?? document;
          scope.querySelectorAll<HTMLElement>('.pub').forEach((card) => {
            const topics = (card.getAttribute('data-topics') || '').split(/\s+/);
            const show = filter === 'all' || topics.includes(filter);
            card.classList.toggle('is-hidden', !show);
          });
          scope.querySelectorAll<HTMLElement>('.pubs__group').forEach((group) => {
            const visible = group.querySelectorAll('.pub:not(.is-hidden)').length;
            group.classList.toggle('is-hidden', visible === 0);
          });
        }
      });
    }
  </script>
</section>
