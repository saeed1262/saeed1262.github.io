---
// Interactive explainer: coherence measures how steadily two signals keep
// time together at a given rhythm, and ignores how big they are.
---
<figure class="viz coh-demo">
  <div class="viz__head">
    <p class="viz__title">What coherence measures</p>
    <p class="viz__sub">Two joints moving to the same 1 Hz rhythm. Change how steady their timing is, or how big joint B moves.</p>
  </div>
  <div class="viz-controls">
    <label class="viz-slider">Timing steadiness
      <input type="range" min="0" max="100" value="85" data-steady aria-label="Timing steadiness" />
    </label>
    <label class="viz-slider">Size of B
      <input type="range" min="20" max="160" value="100" data-size aria-label="Size of joint B's movement" />
    </label>
  </div>
  <div class="coh-demo__body">
    <div class="viz-legend">
      <span><i style="background: var(--ink)"></i>joint A</span>
      <span><i class="dash" style="color: var(--c-other)"></i>joint B</span>
    </div>
    <div class="viz__plot" data-plot></div>
    <div class="coh-demo__out">
      <p class="viz-readout"><span data-coh>–</span><small>coherence at the 1 Hz rhythm<br />(0 = no steady timing, 1 = locked)</small></p>
    </div>
  </div>
  <figcaption class="viz__caption">
    Coherence is computed over 96 seconds of motion; the plot shows the last 8. Making B bigger or smaller
    barely moves the number: coherence is about timing, not size. That is also why filtering every joint
    the same way leaves it unchanged.
  </figcaption>
  <style>
    .coh-demo__body { display: grid; grid-template-columns: 1fr auto; gap: 0.5rem 1.5rem; align-items: center; }
    .coh-demo__body .viz-legend { grid-column: 1 / -1; margin-bottom: 0; }
    .coh-demo__out { min-width: 9rem; }
    @media (max-width: 560px) { .coh-demo__body { grid-template-columns: 1fr; } }
  </style>
</figure>

<script>
  import { onEachPage, responsive, svgEl, linear, rng, gaussian } from '@/scripts/viz';

  const FS = 50, SECONDS = 96, F0 = 1, SEG = 4 * FS, SHOW = 8 * FS;

  function simulate(steady: number, size: number) {
    // Each joint's timing wobbles around its usual offset (a mean-reverting
    // random process, ~1.5 s memory). Less steady = bigger wobble.
    const r = rng(7);
    const n = FS * SECONDS;
    const a = new Float64Array(n), b = new Float64Array(n);
    const sigma = 0.08 + (1 - steady) * 2.2;            // radians
    const k = Math.exp(-1 / (FS * 1.5));
    const kick = sigma * Math.sqrt(1 - k * k);
    let pa = sigma * gaussian(r), pb = sigma * gaussian(r);
    for (let i = 0; i < n; i++) {
      pa = k * pa + kick * gaussian(r);
      pb = k * pb + kick * gaussian(r);
      const t = i / FS;
      a[i] = Math.sin(2 * Math.PI * F0 * t + pa) + 0.06 * gaussian(r);
      b[i] = size * (Math.sin(2 * Math.PI * F0 * t + 0.7 + pb) + 0.06 * gaussian(r));
    }
    return { a, b };
  }

  function coherenceAtF0(a: Float64Array, b: Float64Array) {
    // Average the cross- and auto-spectra at F0 over 4 s Hann-windowed segments (50% overlap).
    let sxyRe = 0, sxyIm = 0, sxx = 0, syy = 0;
    for (let s = 0; s + SEG <= a.length; s += SEG / 2) {
      let xr = 0, xi = 0, yr = 0, yi = 0;
      for (let k = 0; k < SEG; k++) {
        const w = 0.5 - 0.5 * Math.cos((2 * Math.PI * k) / (SEG - 1));
        const ang = (2 * Math.PI * F0 * k) / FS;
        const c = Math.cos(ang), sn = Math.sin(ang);
        xr += w * a[s + k] * c; xi -= w * a[s + k] * sn;
        yr += w * b[s + k] * c; yi -= w * b[s + k] * sn;
      }
      sxyRe += xr * yr + xi * yi; sxyIm += xi * yr - xr * yi;
      sxx += xr * xr + xi * xi; syy += yr * yr + yi * yi;
    }
    return (sxyRe ** 2 + sxyIm ** 2) / (sxx * syy);
  }

  onEachPage('.coh-demo', (root) => {
    const plot = root.querySelector<HTMLElement>('[data-plot]')!;
    const steadyEl = root.querySelector<HTMLInputElement>('[data-steady]')!;
    const sizeEl = root.querySelector<HTMLInputElement>('[data-size]')!;
    const out = root.querySelector<HTMLElement>('[data-coh]')!;
    let width = 0;

    function draw() {
      if (!width) return;
      const steady = Number(steadyEl.value) / 100;
      const size = Number(sizeEl.value) / 100;
      const { a, b } = simulate(steady, size);
      out.textContent = coherenceAtF0(a, b).toFixed(2);
      const h = 150, m = { l: 6, r: 6, t: 8, b: 22 };
      plot.replaceChildren();
      const svg = svgEl('svg', { viewBox: `0 0 ${width} ${h}`, role: 'img',
        'aria-label': `Two traces; coherence ${out.textContent}` }, plot);
      const x = linear(0, SHOW - 1, m.l, width - m.r);
      const y = linear(-1.75, 1.75, h - m.b, m.t);
      svgEl('line', { x1: m.l, x2: width - m.r, y1: y(0), y2: y(0), class: 'grid' }, svg);
      for (let s = 0; s <= 8; s += 2) {
        const xx = x(s * FS - (s === 8 ? 1 : 0));
        const t = svgEl('text', { x: xx, y: h - 6, 'text-anchor': s === 0 ? 'start' : s === 8 ? 'end' : 'middle' }, svg);
        t.textContent = `${s} s`;
      }
      const start = a.length - SHOW;
      const path = (arr: Float64Array) => {
        let d = '';
        for (let i = 0; i < SHOW; i += 1) d += `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(Math.max(-1.7, Math.min(1.7, arr[start + i]))).toFixed(1)}`;
        return d;
      };
      svgEl('path', { d: path(a), fill: 'none', 'stroke-width': 2, 'stroke-linejoin': 'round', style: 'stroke: var(--ink)' }, svg);
      svgEl('path', { d: path(b), fill: 'none', 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-dasharray': '5 4', style: 'stroke: var(--c-other)' }, svg);
    }
    steadyEl.addEventListener('input', draw);
    sizeEl.addEventListener('input', draw);
    responsive(plot, (w) => { width = w; draw(); });
  });
</script>
