---
// Median spectrum of the right wrist's up-down motion: real, ZeroEGGS, cleaned.
---
<figure class="viz spec-chart">
  <div class="viz__head">
    <p class="viz__title">ZeroEGGS is smoother than the actor</p>
    <p class="viz__sub">How much the right wrist moves up and down at each tempo (median over the 21 held-out takes, log scale)</p>
  </div>
  <div class="viz-legend">
    <span><i style="background: var(--c-real)"></i>real actor</span>
    <span><i style="background: var(--c-zeggs)"></i>ZeroEGGS</span>
    <span><i class="dash" style="color: var(--c-clean)"></i>real, cleaned at 6 Hz</span>
  </div>
  <div class="viz__plot" data-plot></div>
  <figcaption class="viz__caption">
    Slow sway sits on the left, gesture strokes around 1–3 Hz, quick twitches and beats further right.
    Above 8 Hz (shaded) the analysis stops: there the real data fades into sensor noise and the cleaned
    copy has almost nothing left.
  </figcaption>
  <details>
    <summary>Show as a table</summary>
    <div class="table-wrap"><table data-table></table></div>
  </details>
</figure>

<script>
  import data from '@/data/blog/fake-motion.json';
  import { onEachPage, responsive, svgEl, svgText, linear, log10Scale, makeTooltip } from '@/scripts/viz';

  const S = data.real.spectra;
  const SERIES = [
    { key: 'real', label: 'real actor', color: 'var(--c-real)', dash: '' },
    { key: 'zeroeggs', label: 'ZeroEGGS', color: 'var(--c-zeggs)', dash: '' },
    { key: 'cleaned', label: 'real, cleaned at 6 Hz', color: 'var(--c-clean)', dash: '6 5' },
  ] as const;
  const SUP: Record<string, string> = { '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' };
  const pow10 = (e: number) => '10' + String(e).split('').map((c) => SUP[c]).join('');
  const sci = (v: number) => { const e = Math.floor(Math.log10(v)); return `${(v / 10 ** e).toFixed(1)}×${pow10(e)}`; };

  onEachPage('.spec-chart', (root) => {
    const plot = root.querySelector<HTMLElement>('[data-plot]')!;
    const tip = makeTooltip(plot);
    const table = root.querySelector<HTMLTableElement>('[data-table]')!;
    const head = table.createTHead().insertRow();
    for (const h of ['Frequency (Hz)', 'Real', 'ZeroEGGS', 'Real, cleaned']) { const th = document.createElement('th'); th.textContent = h; head.appendChild(th); }
    const body = table.createTBody();
    S.freq.forEach((f: number, i: number) => {
      if (i % 4) return;
      const tr = body.insertRow();
      tr.insertCell().textContent = f.toFixed(1);
      for (const s of SERIES) tr.insertCell().textContent = sci((S as any)[s.key][i]);
    });

    responsive(plot, (width) => {
      plot.replaceChildren(tip.el);
      const h = Math.round(Math.min(340, Math.max(240, width * 0.48)));
      const m = { l: 46, r: 12, t: 10, b: 30 };
      const x = linear(0, 20, m.l, width - m.r);
      const y = log10Scale(1e-11, 3e2, h - m.b, m.t);
      const svg = svgEl('svg', { viewBox: `0 0 ${width} ${h}`, role: 'img',
        'aria-label': 'Spectra: ZeroEGGS has about 40 times less power than the actor at 4 to 8 hertz' }, plot);
      svgEl('rect', { x: x(8), y: m.t, width: x(20) - x(8), height: h - m.b - m.t, style: 'fill: var(--grid)', opacity: 0.55 }, svg);
      svgText(svg, x(8) + 6, m.t + 14, 'not analysed', { 'font-size': 10.5 });
      for (let e = -10; e <= 2; e += 2) {
        svgEl('line', { x1: m.l, x2: width - m.r, y1: y(10 ** e), y2: y(10 ** e), class: 'grid' }, svg);
        svgText(svg, m.l - 6, y(10 ** e) + 4, pow10(e), { 'text-anchor': 'end' });
      }
      for (let f = 0; f <= 20; f += width < 480 ? 5 : 2) svgText(svg, x(f), h - m.b + 16, String(f), { 'text-anchor': 'middle' });
      svgText(svg, width - m.r, h - 2, 'frequency (Hz)', { 'text-anchor': 'end', 'font-size': 10.5 });
      svgText(svg, 4, m.t + 2, 'cm²/Hz', { 'font-size': 10.5 });
      svgEl('line', { x1: m.l, x2: width - m.r, y1: h - m.b, y2: h - m.b, class: 'axis' }, svg);

      for (const s of SERIES) {
        const d = S.freq.map((f: number, i: number) => `${i ? 'L' : 'M'}${x(f).toFixed(1)},${y((S as any)[s.key][i]).toFixed(1)}`).join('');
        svgEl('path', { d, fill: 'none', 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round',
          'stroke-dasharray': s.dash || undefined, style: `stroke: ${s.color}` }, svg);
      }

      // The gap at 6 Hz: real vs ZeroEGGS.
      const i6 = S.freq.reduce((best: number, f: number, i: number) => (Math.abs(f - 6) < Math.abs(S.freq[best] - 6) ? i : best), 0);
      const yr = y(S.real[i6]), yz = y(S.zeroeggs[i6]);
      const gx = x(S.freq[i6]);
      svgEl('line', { x1: gx, x2: gx, y1: yr + 4, y2: yz - 4, 'stroke-width': 1.5, style: 'stroke: var(--ink-2)' }, svg);
      svgEl('path', { d: `M${gx - 4},${yr + 9}L${gx},${yr + 3}L${gx + 4},${yr + 9}M${gx - 4},${yz - 9}L${gx},${yz - 3}L${gx + 4},${yz - 9}`, fill: 'none', 'stroke-width': 1.5, style: 'stroke: var(--ink-2)' }, svg);
      // Label sits in the empty space under the ZeroEGGS curve.
      svgText(svg, gx - 6, yz + 22, `≈${Math.round(S.real[i6] / S.zeroeggs[i6])}× less at ${S.freq[i6].toFixed(0)} Hz`, { 'text-anchor': 'end', class: 't-ink', 'font-size': 11 });

      // Crosshair + tooltip.
      const cross = svgEl('line', { y1: m.t, y2: h - m.b, class: 'axis', visibility: 'hidden' }, svg);
      const hit = svgEl('rect', { x: m.l, y: m.t, width: width - m.l - m.r, height: h - m.t - m.b, fill: 'transparent' }, svg);
      hit.addEventListener('pointermove', (ev) => {
        const r = svg.getBoundingClientRect();
        const px = ((ev.clientX - r.left) / r.width) * width;
        const f = Math.min(20, Math.max(0, x.invert(px)));
        const i = S.freq.reduce((b: number, ff: number, k: number) => (Math.abs(ff - f) < Math.abs(S.freq[b] - f) ? k : b), 0);
        cross.setAttribute('x1', String(x(S.freq[i]))); cross.setAttribute('x2', String(x(S.freq[i])));
        cross.setAttribute('visibility', 'visible');
        const scale = r.width / width;
        tip.show(x(S.freq[i]) * scale, ((ev.clientY - r.top)), `${S.freq[i].toFixed(1)} Hz`,
          SERIES.map((s) => ({ value: sci((S as any)[s.key][i]), label: s.label, color: s.color })));
      });
      hit.addEventListener('pointerleave', () => { tip.hide(); cross.setAttribute('visibility', 'hidden'); });
    });
  });
</script>
