---
// Three simulated walkers (side view): real, Frankenstein, wrong arm swing.
// Pure simulation, same model as the post's toy experiment.
---
<figure class="viz walker-demo">
  <div class="viz__head">
    <p class="viz__title">Three toy walkers</p>
    <p class="viz__sub">Each joint's motion is realistic on its own. Only how the joints keep time together differs.</p>
  </div>
  <div class="viz-controls">
    <button type="button" class="viz-btn" data-toggle aria-pressed="true">Pause</button>
  </div>
  <div class="walker-demo__grid">
    <div class="walker-demo__panel">
      <svg viewBox="-80 -20 160 210" data-walker="real" role="img" aria-label="Real walker: arms swing opposite the legs, one shared rhythm"></svg>
      <p class="walker-demo__name"><i style="background: var(--c-real)"></i>Real</p>
      <p class="walker-demo__note">One shared rhythm; each arm swings opposite its leg.</p>
    </div>
    <div class="walker-demo__panel">
      <svg viewBox="-80 -20 160 210" data-walker="frank" role="img" aria-label="Frankenstein walker: every joint from a different recording, drifting in and out of sync"></svg>
      <p class="walker-demo__name"><i style="background: var(--c-frank)"></i>Frankenstein</p>
      <p class="walker-demo__note">Every joint is real motion, taken from a different walk.</p>
    </div>
    <div class="walker-demo__panel">
      <svg viewBox="-80 -20 160 210" data-walker="wrong" role="img" aria-label="Wrong arm swing: arms swing with the same-side leg, steadily"></svg>
      <p class="walker-demo__name"><i style="background: var(--c-other)"></i>Wrong arm swing</p>
      <p class="walker-demo__note">Perfectly steady timing, but the arms swing with the wrong leg.</p>
    </div>
  </div>
  <style>
    .walker-demo__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; align-items: start; }
    .walker-demo__panel { text-align: center; }
    .walker-demo__panel svg { width: 100%; max-width: 190px; height: auto; display: block; margin: 0 auto; }
    .walker-demo__name { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; color: var(--ink); font-size: 0.9rem; margin-top: 0.3rem; }
    .walker-demo__name i { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
    .walker-demo__note { font-size: 0.8rem; color: var(--ink-2); line-height: 1.4; margin-top: 0.15rem; }
    @media (max-width: 560px) { .walker-demo__grid { gap: 0.4rem; } .walker-demo__note { display: none; } .walker-demo__name { font-size: 0.78rem; } }
  </style>
</figure>

<script>
  import { onEachPage, svgEl, reducedMotion } from '@/scripts/viz';

  const D = Math.PI / 180;
  type Kind = 'real' | 'frank' | 'wrong';
  // Per-joint cadence (Hz) and phase offset for the Frankenstein walker:
  // each joint comes from a different simulated walk.
  const FRANK: Record<string, [number, number]> = {
    hipL: [0.92, 0.0], hipR: [0.84, 2.1], kneeL: [0.97, 1.0], kneeR: [0.88, 4.0],
    shL: [0.81, 0.4], shR: [0.99, 5.2], elL: [0.86, 2.9], elR: [0.94, 1.7],
  };
  const F = 0.9;

  function phase(kind: Kind, joint: string, t: number, side: number) {
    if (kind === 'frank') { const [f, p] = FRANK[joint]; return 2 * Math.PI * f * t + p; }
    return 2 * Math.PI * F * t + side;
  }

  function angles(kind: Kind, t: number) {
    const out: Record<string, number> = {};
    for (const [s, side] of [['L', 0], ['R', Math.PI]] as const) {
      const ph = (j: string) => phase(kind, j + s, t, side);
      out['hip' + s] = 22 * Math.cos(ph('hip'));
      out['knee' + s] = Math.max(0, 18 + 20 * Math.cos(ph('knee') - 1.1) + 7 * Math.cos(2 * ph('knee') + 0.5));
      const armPh = kind === 'wrong' ? ph('sh') : ph('sh') + Math.PI;
      out['sh' + s] = 18 * Math.cos(armPh);
      out['el' + s] = 20 + 9 * Math.cos((kind === 'wrong' ? ph('el') : ph('el') + Math.PI) - 0.4);
    }
    return out;
  }

  function limb(g: SVGGElement, x: number, y: number, a1: number, l1: number, a2: number, l2: number, cls: string) {
    const x1 = x + l1 * Math.sin(a1), y1 = y + l1 * Math.cos(a1);
    const x2 = x1 + l2 * Math.sin(a2), y2 = y1 + l2 * Math.cos(a2);
    svgEl('path', { d: `M${x},${y}L${x1},${y1}L${x2},${y2}`, class: cls }, g);
  }

  function drawFigure(svg: SVGSVGElement, kind: Kind, t: number) {
    svg.replaceChildren();
    const a = angles(kind, t);
    const bob = 2 * Math.cos(2 * phase(kind, 'hipL', t, 0));
    const hip = { x: 0, y: 92 + bob };
    const neck = { x: 4, y: 32 + bob };
    svgEl('line', { x1: -70, x2: 70, y1: 182, y2: 182, class: 'walker-ground' }, svg);
    const far = svgEl('g', { class: 'walker-far' }, svg);
    const near = svgEl('g', { class: 'walker-near' }, svg);
    // Legs: thigh 46, shank 44. Arms: upper 30, forearm 28.
    limb(far, hip.x, hip.y, a.hipR * D, 46, (a.hipR - a.kneeR) * D, 44, 'walker-limb');
    limb(far, neck.x, neck.y + 6, a.shR * D, 30, (a.shR + a.elR) * D, 28, 'walker-limb');
    svgEl('path', { d: `M${hip.x},${hip.y}L${neck.x},${neck.y}`, class: 'walker-limb walker-torso' }, near);
    svgEl('circle', { cx: neck.x + 3, cy: neck.y - 15, r: 11, class: 'walker-head' }, near);
    limb(near, hip.x, hip.y, a.hipL * D, 46, (a.hipL - a.kneeL) * D, 44, 'walker-limb');
    limb(near, neck.x, neck.y + 6, a.shL * D, 30, (a.shL + a.elL) * D, 28, 'walker-limb');
  }

  onEachPage('.walker-demo', (root) => {
    const svgs = [...root.querySelectorAll<SVGSVGElement>('[data-walker]')];
    const btn = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    let playing = !reducedMotion();
    let visible = false;
    let t = 0.4, last = 0;
    const render = () => svgs.forEach((s) => drawFigure(s, s.dataset.walker as Kind, t));
    const setBtn = () => { btn.textContent = playing ? 'Pause' : 'Play'; btn.setAttribute('aria-pressed', String(playing)); };
    setBtn();
    render();
    function frame(now: number) {
      if (!root.isConnected) return;
      if (playing && visible) {
        t += Math.min(0.05, (now - last) / 1000 || 0);
        render();
      }
      last = now;
      requestAnimationFrame(frame);
    }
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; }).observe(root);
    btn.addEventListener('click', () => { playing = !playing; setBtn(); });
    requestAnimationFrame(frame);
  });
</script>

<style is:global>
  .walker-demo .walker-limb { fill: none; stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; }
  .walker-demo .walker-near .walker-limb, .walker-demo .walker-head { stroke: var(--ink); }
  .walker-demo .walker-far .walker-limb { stroke: var(--ink-2); opacity: 0.45; }
  .walker-demo .walker-torso { stroke-width: 7; }
  .walker-demo .walker-head { fill: var(--viz-surface); stroke-width: 5; }
  .walker-demo .walker-ground { stroke: var(--grid); stroke-width: 2; }
</style>
