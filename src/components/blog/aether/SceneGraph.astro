---
// The Director's scene graph for scene 1 of the Elara story (from the paper's
// supplementary material), with a toggle that applies one hand-written update.
---
<figure class="viz aw-graph">
  <div class="viz__head">
    <p class="viz__title">The story's world as a graph</p>
    <p class="viz__sub">What the Director knew after scene 1 of the Elara story. Hover or tab to a node to see its attributes.</p>
  </div>
  <div class="viz-controls">
    <div class="viz-seg" role="group" aria-label="Which version of the graph">
      <button type="button" data-view="paper" aria-pressed="true">Scene 1 (from the paper)</button>
      <button type="button" data-view="next" aria-pressed="false">After one more sentence</button>
    </div>
  </div>
  <div class="aw-graph__legend viz-legend" aria-hidden="true">
    <span><i class="dot" style="background: var(--k-location)"></i>Location</span>
    <span><i class="dot" style="background: var(--k-character)"></i>Character</span>
    <span><i class="dot" style="background: var(--k-object)"></i>Key object</span>
    <span><i class="dot" style="background: var(--k-event)"></i>Event</span>
  </div>
  <div class="viz__plot" data-plot></div>
  <div class="aw-graph__update" data-update hidden>
    <p class="aw-graph__sentence" data-sentence></p>
    <ul class="aw-graph__diff" data-diff></ul>
  </div>
  <figcaption class="viz__caption">
    Scene 1's nodes, attributes and edges are exactly as the Director produced them in the paper. The second view is
    my illustration: a sentence I wrote for this post, and the changes the Director's rules call for.
  </figcaption>
  <details>
    <summary>Show as a list</summary>
    <div class="table-wrap"><table data-table></table></div>
  </details>
  <style is:global>
    .aw-graph { --k-location: var(--c-clean); --k-character: var(--c-zeggs); --k-object: var(--c-frank); --k-event: var(--c-real); }
    .aw-graph .node rect { fill: var(--viz-surface); stroke-width: 1.5; }
    .aw-graph .node:focus { outline: none; }
    .aw-graph .node:focus rect, .aw-graph .node:hover rect { stroke-width: 2.5; }
    .aw-graph .edge { stroke: var(--ink-2); stroke-width: 1.4; fill: none; }
    .aw-graph .edge--new { stroke: var(--accent-from); stroke-width: 2; }
    .aw-graph .edge-label rect { fill: var(--viz-surface); }
    .aw-graph__update { margin-top: 0.4rem; padding: 0.7rem 0.9rem; border-radius: 10px; background: var(--bg-deep); font-size: 0.84rem; }
    .aw-graph__sentence { color: var(--ink); font-style: italic; }
    .aw-graph__diff { list-style: none; padding: 0; margin: 0.4rem 0 0; display: grid; gap: 0.2rem; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.78rem; color: var(--ink); }
    .aw-graph__diff b { display: inline-block; width: 1.1rem; font-weight: 700; color: var(--ink-2); }
  </style>
</figure>

<script>
  import { onEachPage, responsive, svgEl, svgText, makeTooltip, reducedMotion } from '@/scripts/viz';
  import { scene1, illustration, type GraphEdge, type GraphNode } from '@/data/blog/aether-weaver';

  const KIND_NAME = { location: 'Location', character: 'Character', object: 'Key object', event: 'Event' } as const;
  // Positions as fractions of the plot; Elara moves between her two spots.
  const POS: Record<string, [number, number]> = {
    woods: [0.5, 0.12], elderwood: [0.2, 0.47], revelation: [0.5, 0.47], shrine: [0.8, 0.47], elara: [0.2, 0.84],
  };
  const ELARA_NEXT: [number, number] = [0.8, 0.84];

  onEachPage('.aw-graph', (root) => {
    const plot = root.querySelector<HTMLElement>('[data-plot]')!;
    const update = root.querySelector<HTMLElement>('[data-update]')!;
    const table = root.querySelector<HTMLTableElement>('[data-table]')!;
    const tip = makeTooltip(plot);
    const markerId = `aw-arrow-${Math.random().toString(36).slice(2, 8)}`;
    let view: 'paper' | 'next' = 'paper';
    let elaraT = 0; // 0 = scene 1 position, 1 = after the update
    let width = 0;

    // Fill in the update text once.
    root.querySelector('[data-sentence]')!.textContent = `“${illustration.sentence}”`;
    const diff = root.querySelector('[data-diff]')!;
    const name = (id: string) => scene1.nodes.find((n) => n.id === id)!.label;
    const lines: [string, string][] = [
      ['−', `${name(illustration.removed.from)} ${illustration.removed.label} ${name(illustration.removed.to)}`],
      ['+', `${name(illustration.added.from)} ${illustration.added.label} ${name(illustration.added.to)}`],
      ['~', `${name(illustration.attr[0])}.${illustration.attr[1]}: ${illustration.attr[2]} → ${illustration.attr[3]}`],
    ];
    for (const [sign, text] of lines) {
      const li = document.createElement('li');
      const b = document.createElement('b');
      b.textContent = sign;
      li.append(b, text);
      diff.appendChild(li);
    }

    function current() {
      const edges: (GraphEdge & { fresh?: boolean })[] = scene1.edges
        .filter((e) => !(view === 'next' && e.from === illustration.removed.from && e.to === illustration.removed.to))
        .map((e) => ({ ...e }));
      if (view === 'next') edges.push({ ...illustration.added, fresh: true });
      const nodes: GraphNode[] = scene1.nodes.map((n) =>
        view === 'next' && n.id === illustration.attr[0]
          ? { ...n, attrs: n.attrs.map(([k, v]) => [k, k === illustration.attr[1] ? illustration.attr[3] : v] as [string, string]) }
          : n);
      return { nodes, edges };
    }

    function fillTable() {
      const { nodes, edges } = current();
      table.replaceChildren();
      const head = table.createTHead().insertRow();
      for (const h of ['Node or edge', 'Type', 'Attributes']) { const th = document.createElement('th'); th.textContent = h; head.appendChild(th); }
      const body = table.createTBody();
      for (const n of nodes) {
        const r = body.insertRow();
        r.insertCell().textContent = n.label;
        r.insertCell().textContent = KIND_NAME[n.kind];
        r.insertCell().textContent = n.attrs.map(([k, v]) => `${k}: ${v}`).join('; ');
      }
      for (const e of edges) {
        const r = body.insertRow();
        r.insertCell().textContent = `${name(e.from)} → ${name(e.to)}`;
        r.insertCell().textContent = 'Edge';
        r.insertCell().textContent = e.label;
      }
    }

    function draw() {
      if (!width) return;
      const { nodes, edges } = current();
      plot.replaceChildren(tip.el);
      tip.hide();
      const narrow = width < 560;
      const H = narrow ? 330 : 360;
      const bw = Math.min(150, width * 0.27), bh = narrow ? 52 : 50;
      const pos = (id: string): [number, number] => {
        const p = id === 'elara'
          ? [POS.elara[0] + (ELARA_NEXT[0] - POS.elara[0]) * elaraT, POS.elara[1]]
          : POS[id];
        return [p[0] * width, p[1] * H];
      };
      const svg = svgEl('svg', { viewBox: `0 0 ${width} ${H}`, role: 'img',
        'aria-label': view === 'paper'
          ? 'Scene graph: Elara is at the Elderwood; the Elderwood and the Forgotten Shrine are inside the Whispering Woods; a Spirit Revelation event involves Elara and the Elderwood.'
          : 'Scene graph after the update: Elara is now at the Forgotten Shrine.' }, plot);
      const defs = svgEl('defs', {}, svg);
      const marker = svgEl('marker', { id: markerId, viewBox: '0 0 10 10', refX: 9, refY: 5, markerWidth: 7, markerHeight: 7, orient: 'auto-start-reverse' }, defs);
      svgEl('path', { d: 'M0,0 L10,5 L0,10 z', style: 'fill: var(--ink-2)' }, marker);

      // Edges: from box edge to box edge, labelled at the midpoint.
      const clip = (cx: number, cy: number, tx: number, ty: number) => {
        const dx = tx - cx, dy = ty - cy;
        const s = Math.min(Math.abs((bw / 2 + 4) / (dx || 1e-9)), Math.abs((bh / 2 + 4) / (dy || 1e-9)));
        return [cx + dx * s, cy + dy * s];
      };
      for (const e of edges) {
        const [ax, ay] = pos(e.from), [bx, by] = pos(e.to);
        const [x1, y1] = clip(ax, ay, bx, by), [x2, y2] = clip(bx, by, ax, ay);
        svgEl('line', { x1, y1, x2, y2, class: `edge${e.fresh ? ' edge--new' : ''}`, 'marker-end': `url(#${markerId})` }, svg);
        const g = svgEl('g', { class: 'edge-label' }, svg);
        const mx = (x1 + x2) / 2, my = (y1 + y2) / 2;
        const t = svgText(g, mx, my + 4, e.label, { 'text-anchor': 'middle', 'font-size': 10, class: 't-ink' });
        const w = e.label.length * 6.2 + 8;
        const bg = svgEl('rect', { x: mx - w / 2, y: my - 8, width: w, height: 15, rx: 4 });
        g.insertBefore(bg, t);
      }

      // Nodes: kind tag on top, name below; colour plus the tag text, so kind is never colour-only.
      for (const n of nodes) {
        const [cx, cy] = pos(n.id);
        const g = svgEl('g', { class: 'node', tabindex: 0, 'aria-label': `${KIND_NAME[n.kind]}: ${n.label}. ${n.attrs.map(([k, v]) => `${k}: ${v}`).join('. ')}` }, svg);
        svgEl('rect', { x: cx - bw / 2, y: cy - bh / 2, width: bw, height: bh, rx: 10, style: `stroke: var(--k-${n.kind})` }, g);
        svgEl('circle', { cx: cx - bw / 2 + (narrow ? 9 : 12), cy: narrow ? cy : cy - bh / 2 + 13, r: 4, style: `fill: var(--k-${n.kind})` }, g);
        if (narrow) {
          // Phones: no room for the kind tag (the legend, tooltip and list carry it); wrap long names.
          const words = n.label.split(' ');
          const twoLines = words.length > 1 && n.label.length > 11;
          const parts = twoLines ? [words.slice(0, -1).join(' '), words[words.length - 1]] : [n.label];
          parts.forEach((p, i) => svgText(g, cx - bw / 2 + 17, cy - (parts.length - 1) * 6.5 + i * 13 + 4, p, { 'font-size': 10.5, class: 't-strong' }));
        } else {
          svgText(g, cx - bw / 2 + 21, cy - bh / 2 + 16.5, KIND_NAME[n.kind].toUpperCase(), { 'font-size': 9, 'letter-spacing': '0.06em' });
          svgText(g, cx - bw / 2 + 10, cy + bh / 2 - 12, n.label, { 'font-size': 12.5, class: 't-strong' });
        }
        const show = () => {
          const scale = plot.getBoundingClientRect().width / width;
          tip.show(cx * scale, (cy - bh / 2) * scale, `${KIND_NAME[n.kind]}: ${n.label}`,
            n.attrs.map(([k, v]) => ({ value: v.length > 60 ? `${v.slice(0, 58)}…` : v, label: k })));
        };
        g.addEventListener('pointerenter', show);
        g.addEventListener('focus', show);
        g.addEventListener('pointerleave', () => tip.hide());
        g.addEventListener('blur', () => tip.hide());
      }
    }

    function animateTo(target: number) {
      if (reducedMotion()) { elaraT = target; draw(); return; }
      const from = elaraT, t0 = performance.now(), dur = 650;
      const step = (now: number) => {
        const k = Math.min(1, (now - t0) / dur);
        elaraT = from + (target - from) * (1 - (1 - k) ** 3);
        draw();
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => {
      const next = b.dataset.view as 'paper' | 'next';
      if (next === view) return;
      view = next;
      root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      update.hidden = view !== 'next';
      fillTable();
      animateTo(view === 'next' ? 1 : 0);
    }));
    fillTable();
    responsive(plot, (w) => { width = w; draw(); });
  });
</script>
