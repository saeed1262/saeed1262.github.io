---
// Table 1 of the paper as a dumbbell chart: mean expert rating for Aether
// Weaver and the cascaded baseline, on the full 1-5 scale.
---
<figure class="viz aw-res">
  <div class="viz__head">
    <p class="viz__title">How experts rated the stories</p>
    <p class="viz__sub">Mean rating on a 1–5 scale; 10 story prompts per system, rated by a panel of 10 experts</p>
  </div>
  <div class="viz-legend">
    <span><i class="dot" style="background: var(--c-real)"></i>Aether Weaver</span>
    <span><i class="dot" style="background: transparent; box-sizing: border-box; border: 2px solid var(--c-other)"></i>Cascaded baseline</span>
  </div>
  <div class="viz__plot" data-plot></div>
  <figcaption class="viz__caption">
    From Table 1 of the paper. The paper reports means only, so there are no error bars here. The number on the right
    is how much higher Aether Weaver scored.
  </figcaption>
  <details>
    <summary>Show as a table</summary>
    <div class="table-wrap"><table data-table></table></div>
  </details>
</figure>

<script>
  import { onEachPage, responsive, svgEl, svgText, linear, makeTooltip } from '@/scripts/viz';
  import { results } from '@/data/blog/aether-weaver';

  onEachPage('.aw-res', (root) => {
    const plot = root.querySelector<HTMLElement>('[data-plot]')!;
    const table = root.querySelector<HTMLTableElement>('[data-table]')!;
    const tip = makeTooltip(plot);

    const head = table.createTHead().insertRow();
    for (const h of ['Metric', 'Aether Weaver', 'Baseline', 'Difference']) { const th = document.createElement('th'); th.textContent = h; head.appendChild(th); }
    const body = table.createTBody();
    for (const r of results) {
      const tr = body.insertRow();
      for (const v of [r.metric, r.aw.toFixed(2), r.base.toFixed(2), `+${(r.aw - r.base).toFixed(2)}`]) tr.insertCell().textContent = v;
    }

    responsive(plot, (width) => {
      plot.replaceChildren(tip.el);
      tip.hide();
      const narrow = width < 560;
      const labelW = narrow ? 0 : Math.min(190, width * 0.3);
      const diffW = 46;
      const rowH = narrow ? 52 : 36, top = 8, axisH = 26;
      const H = top + rowH * results.length + axisH;
      const x = linear(1, 5, labelW + 10, width - diffW - 8);
      const svg = svgEl('svg', { viewBox: `0 0 ${width} ${H}`, role: 'img', 'aria-label': 'Aether Weaver scores higher than the baseline on all five metrics; the biggest gaps are visual coherence and affective alignment.' }, plot);
      const bottom = top + rowH * results.length;
      for (const t of [1, 2, 3, 4, 5]) {
        svgEl('line', { x1: x(t), x2: x(t), y1: top, y2: bottom, class: t === 1 ? 'axis' : 'grid' }, svg);
        svgText(svg, x(t), bottom + 16, String(t), { 'text-anchor': 'middle' });
      }
      svgText(svg, width - 4, top + 2, 'gap', { 'text-anchor': 'end', 'font-size': 10.5 });
      results.forEach((r, i) => {
        const cy = top + rowH * i + (narrow ? rowH - 14 : rowH / 2);
        if (narrow) svgText(svg, x(1), cy - 16, r.metric, { class: 't-ink' });
        else svgText(svg, labelW - 4, cy + 4, r.metric, { 'text-anchor': 'end', class: 't-ink' });
        svgEl('line', { x1: x(r.base), x2: x(r.aw), y1: cy, y2: cy, 'stroke-width': 3, 'stroke-linecap': 'round', style: 'stroke: var(--axis)' }, svg);
        // Baseline: a hollow ring, so the two series differ in shape as well as colour.
        svgEl('circle', { cx: x(r.base), cy, r: 5.5, style: 'fill: var(--viz-surface); stroke: var(--c-other)', 'stroke-width': 2.5 }, svg);
        svgEl('circle', { cx: x(r.aw), cy, r: 6, style: 'fill: var(--c-real); stroke: var(--viz-surface)', 'stroke-width': 2 }, svg);
        svgText(svg, width - 4, cy + 4, `+${(r.aw - r.base).toFixed(2)}`, { 'text-anchor': 'end', class: 't-strong' });
        const hit = svgEl('rect', { x: 0, y: cy - rowH / 2 - (narrow ? 4 : 0), width, height: rowH, fill: 'transparent', tabindex: 0,
          'aria-label': `${r.metric}: Aether Weaver ${r.aw.toFixed(2)}, baseline ${r.base.toFixed(2)}` }, svg);
        const show = () => {
          const scale = plot.getBoundingClientRect().width / width;
          tip.show(x(r.aw) * scale, cy * scale, r.metric, [
            { value: r.aw.toFixed(2), label: 'Aether Weaver', color: 'var(--c-real)' },
            { value: r.base.toFixed(2), label: 'Cascaded baseline', color: 'var(--c-other)' },
          ]);
        };
        hit.addEventListener('pointerenter', show);
        hit.addEventListener('focus', show);
        hit.addEventListener('pointerleave', () => tip.hide());
        hit.addEventListener('blur', () => tip.hide());
      });
    });
  });
</script>
