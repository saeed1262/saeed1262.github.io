---
// A khatam (eight-point star) between two fading rules, dividing home sections.
---
<div class="ornament" aria-hidden="true"><span></span></div>

<style>
  .ornament {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: min(100% - 2rem, 34rem);
    margin-inline: auto;
  }
  .ornament::before,
  .ornament::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--gold) 60%, transparent));
  }
  .ornament::after { transform: scaleX(-1); }
  .ornament span {
    width: 30px;
    height: 30px;
    flex: none;
    background: var(--gold);
    opacity: 0.85;
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><g fill='none' stroke='white' stroke-width='1.6'><rect x='9' y='9' width='22' height='22'/><rect x='9' y='9' width='22' height='22' transform='rotate(45 20 20)'/><circle cx='20' cy='20' r='3.2'/></g></svg>") center / contain no-repeat;
    mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><g fill='none' stroke='white' stroke-width='1.6'><rect x='9' y='9' width='22' height='22'/><rect x='9' y='9' width='22' height='22' transform='rotate(45 20 20)'/><circle cx='20' cy='20' r='3.2'/></g></svg>") center / contain no-repeat;
  }
  @media print { .ornament { display: none; } }
</style>
